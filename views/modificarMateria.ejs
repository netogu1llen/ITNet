<%- include('partials/head') %>
<link rel="stylesheet" href="/styles.css">

<section class="section materia-page">
  <div class="container materia-container">
    <img src="/images/libro.png" alt="Icono libro" class="materia-icon">
    <h1 class="title is-3">Modificar Materia</h1>

    <form class="materia-form" method="POST" action="/materia/Modificar">
      <div class="columns is-centered">
        <div class="column">
          <label class="basic-gray">Nombre de la materia</label>
          <input class="input" type="text" name="nombreMateria" placeholder="Ej. Español" required>
        </div>
        <div class="column">
          <label class="basic-gray">Nivel escolar</label>
          <input class="input" type="text" name="nivelEscolar" placeholder="Ej. Secundaria" required>
        </div>
      </div>

      <div class="field">
        <label class="basic-gray">Grado</label>
        <div class="select is-fullwidth">
          <select name="grado" required>
            <option value="" disabled selected>Selecciona un grado</option>
            <option value="1">1°</option>
            <option value="2">2°</option>
            <option value="3">3°</option>
            <option value="4">4°</option>
            <option value="5">5°</option>
            <option value="6">6°</option>
          </select>
        </div>
      </div>

      <button type="submit" class="button is-save">Guardar Cambios</button>
    </form>
  </div>
</section>
