<%- include('partials/head') %>

<input type="hidden" id="idExpediente" data-modo-edicion="<%= datosSesion ? 'true' : 'false' %>" value="<%= expediente.IDExpediente %>">
<body>
  <main class="container">
    <!-- Página 1 -->
    <div class="entrevista-pagina">
      <div class="box" style="background-color: #f2f2f2;">
        <h1 class="has-text-black pl-6">
          <img src="/images/salud.png" alt="Salud Icon" style="height: 30px;"> Historia Clínica V2
          <div class="buttons-container" style="display: inline-block; margin-left: 60%;">
            <button class="btn-guardar button is-save" type="submit">
              <%= datosSesion ? 'Actualizar' : 'Guardar' %>
            </button>
            <button class="btn-cancelar button is-cancel" type="button">
              Cancelar
            </button>
          </div>
        </h1>
        
        <!-- Información básica -->
        <div class="columns pl-6 pr-6">
          <div class="column has-text-black has-text-weight-semibold">
            No. Expediente: <%= expediente.IDExpediente %>
          </div>
          <div class="column has-text-black has-text-weight-semibold">
            <label>Número de Sesión:</label>
            <input id="numSesion" class="input" type="text" 
              value="<%= datosSesion?.numSesion || '' %>"
              <%= datosSesion ? 'readonly' : '' %>
              style="width: 60px; display: inline-block;"
              required>
          </div>
        </div>

        <!-- Última evaluación V1 -->
        <div class="columns pl-6 pr-6">
          <div class="column">
            <div style="background-color: #f8f9fa; padding: 1rem; border-radius: 4px;">
              <h4 class="title is-6">Última Evaluación (V1)</h4>
              <div class="columns">
                <div class="column">
                  <p><strong> Peso anterior:</strong> <%= datosSesionV1?.peso || 'No registrado' %> kg</p>
                </div>
                <div class="column">
                  <p><strong>Talla anterior:</strong> <%= datosSesionV1?.talla || 'No registrado' %> m</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Resto del contenido de la página 1 -->
        <div class="pl-6">
          <div class="box" style="background-color: #ffffff;">
            <hr class="has-background-grey-lighter">
            
            <!-- Información Básica del Paciente -->
            <div class="columns">
              <div class="column pr-6">
                <div class="columns">
                  <div class="column" style="border:2px">
                    <label class="label">Nombre Completo</label>
                    <input class="input" type="text" 
                          name="expediente[nombreCompleto]" 
                          value="<%= expediente.nombres %> <%= expediente.apellidoP %> <%= expediente.apellidoM %>" 
                          readonly/>
                  </div>
                </div>

                <div class="columns">
                  <div class="column">
                    <label class="label">Edad</label>
                    <%function calcularEdad(fechaNacimiento) {
                          if (!fechaNacimiento) return '';
                          const hoy = new Date();
                          const nacimiento = new Date(fechaNacimiento);
                          let edad = hoy.getFullYear() - nacimiento.getFullYear();
                          const m = hoy.getMonth() - nacimiento.getMonth();
                          if (m < 0 || (m === 0 && hoy.getDate() < nacimiento.getDate())) {
                            edad--;
                          }
                          return edad;
                        }
                      %>
                    <input class="input" type="number" 
                          name="expediente[edad]" 
                          value="<%= calcularEdad(expediente.fechaNacimiento) %>" 
                          readonly/>
                  </div>
                </div>
              </div>
            </div>
            
            <!-- INDICADORES BIOQUÍMICOS -->
            <div class="container">
              <table class="table is-fullwidth" style="border-collapse: collapse; border-radius: 10px; overflow: hidden;">
                <thead>
                  <tr>
                    <th colspan="4" class="has-text-black" style="text-align: center; background-color:#f2f2f2;">
                      I. INDICADORES BIOQUÍMICOS
                    </th>
                  </tr>
                  <tr>
                    <th>Parámetro Bioquímico</th>
                    <th>Valor de referencia</th>
                    <th>Fecha</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody id="tabla-indicadores">
                  <% if (datosSesion?.indicadoresBioquim?.length > 0) { %>
                    <% datosSesion.indicadoresBioquim.forEach(indicador => { %>
                      <% 
                        const fechaIndicador = indicador.parametroFecha 
                          ? new Date(indicador.parametroFecha).toISOString().split('T')[0] 
                          : '';
                      %>
                      <tr>
                        <td>
                          <input class="input" type="text" name="parametroBioquimico[]" 
                            value="<%= indicador.parametro %>" placeholder="Parámetro..." required>
                        </td>
                        <td>
                          <input class="input" type="text" name="valorReferencia[]" 
                            value="<%= indicador.valorReferencia %>" placeholder="Valor de referencia..." required>
                        </td>
                        <td>
                          <input class="input" type="date" name="fechaParametro[]" 
                            value="<%= fechaIndicador %>" required>
                        </td>
                        <td>
                          <button type="button" class="button is-cancel btn-eliminar-fila">-</button>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <!-- Fila por defecto cuando no hay datos -->
                    <tr>
                      <td>
                        <input class="input" type="text" name="parametroBioquimico[]" placeholder="Parámetro..." required>
                      </td>
                      <td>
                        <input class="input" type="text" name="valorReferencia[]" placeholder="Valor de referencia..." required>
                      </td>
                      <td>
                        <input class="input" type="date" name="fechaParametro[]" required>
                      </td>
                      <td>
                        <button type="button" class="button is-cancel btn-eliminar-fila">-</button>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>

              <div class="has-text-centered">
                <button id="btn-agregar-fila" class="button is-save" type="button">
                  ＋ Agregar parámetro
                </button>
              </div>
            </div>

            <!-- EVALUACIÓN ANTROPOMÉTRICA -->
            <div class="container">
              <table class="table is-fullwidth" style="border-collapse: collapse; border-radius: 10px; overflow: hidden;">
                <thead>
                  <tr>
                    <th colspan="3" class="has-text-black" style="text-align: center; background-color:#f2f2f2;">II. EVALUACIÓN ANTROPOMÉTRICA</th>
                  </tr>
                  <tr>
                    <th>Aspectos por evaluar</th>
                    <th>Medidas</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Altura (m)</td>
                    <td><input id="talla" class="input" type="text" 
                        value="<%= datosSesion?.evaluacionAntropometrica?.talla || '' %>" required/></td>
                  </tr>
                  <tr>
                    <td>Peso (kg)</td>
                    <td><input id="peso" class="input" type="text" 
                        value="<%= datosSesion?.evaluacionAntropometrica?.peso || '' %>" required/></td>
                  </tr>
                  <tr>
                    <td>Circunferencia cintura (cm)</td>
                    <td><input id="circunferenciaCintura" class="input" type="text" name="medida[Circunferencia cintura (cm)]" placeholder="Medida..."
                      value="<%= datosSesion?.evaluacionAntropometrica?.circunferenciaCintura || '' %>" required/></td>
                  </tr>
                  <tr>
                    <td>Circunferencia cadera (cm)</td>
                    <td><input id="circunferenciaCadera" class="input" type="text" name="medida[Circunferencia cadera (cm)]" placeholder="Medida..."
                      value="<%= datosSesion?.evaluacionAntropometrica?.circunferenciaCadera || '' %>" required/></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Página 2 -->
    <div class="entrevista-pagina" style="display: none;">
      <div class="box" style="background-color: #f2f2f2;">
        <h1 class="has-text-black pl-6">
          <img src="/images/salud.png" alt="Salud Icon" style="height: 30px;"> Historia Clínica V2
          <div class="buttons-container" style="display: inline-block; margin-left: 60%;">
            <button class="btn-guardar button is-save" type="submit">
              <%= datosSesion ? 'Actualizar' : 'Guardar' %>
            </button>
            <button class="btn-cancelar button is-cancel" type="button">
              Cancelar
            </button>
          </div>
        </h1>
        <div class="pl-6">
          <div class="box" style="background-color: #ffffff;">
            <hr class="has-background-grey-lighter">

            <!-- DIAGNÓSTICO Y EVOLUCIÓN DEL PACIENTE -->
            <div class="container">
              <table class="table is-fullwidth" style="border-collapse: collapse; border-radius: 10px; overflow: hidden;">
                <thead>
                  <tr>
                    <th colspan="2" class="has-text-black" style="text-align: center; background-color:#f2f2f2;">III. DIAGNÓSTICO Y EVOLUCIÓN DEL PACIENTE</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td class="has-text-weight-semibold">Diagnósticos actualizados:</td>
                    <td><textarea id="diagnosticoEvolucion" class="textarea" placeholder="Diagnósticos actualizados..." required><%= datosSesion?.diagnosticoEvolucion?.diagnosticoEvolucion || '' %></textarea></td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- OBJETIVOS NUTRICIONALES -->
            <div class="container">
              <table class="table is-fullwidth" style="border-collapse: collapse; border-radius: 10px; overflow: hidden;">
                <thead>
                  <tr>
                    <th class="has-text-black" style="text-align: center; background-color:#f2f2f2;">
                      IV. OBJETIVOS NUTRICIONALES
                    </th>
                  </tr>
                  <tr>
                    <th>Objetivo</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody id="tabla-objetivos">
                  <% if (datosSesion?.objetivoNutricional?.length > 0) { %>
                    <% datosSesion.objetivoNutricional.forEach(objetivo => { %>
                      <tr>
                        <td>
                          <input class="input" type="text" name="objetivosNutricionales[]" 
                            value="<%= objetivo.objetivo %>" placeholder="Objetivo..." required>
                        </td>
                        <td>
                          <button type="button" class="button is-cancel btn-eliminar-fila">-</button>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <!-- Fila por defecto cuando no hay datos -->
                    <tr>
                      <td>
                        <input class="input" type="text" name="objetivosNutricionales[]" placeholder="Objetivo..." required>
                      </td>
                      <td>
                        <button type="button" class="button is-cancel btn-eliminar-fila">-</button>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            
              <div class="has-text-centered">
                <button id="btn-agregar-fila-objetivos" class="button is-save" type="button">
                  ＋ Agregar objetivo
                </button>
              </div>
            </div>

            <!-- MANEJO NUTRICIONAL -->
            <div class="container">
              <table class="table is-fullwidth" style="border-collapse: collapse; border-radius: 10px; overflow: hidden;">
                <thead>
                  <tr>
                    <th colspan="2" class="has-text-black" style="text-align: center; background-color:#f2f2f2;">V. MANEJO NUTRICIONAL</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Energía (kcal)</td>
                    <td><input id="energia" class="input" type="text" 
                        value="<%= datosSesion?.manejoNutricional?.energia || '' %>" required/></td>
                  </tr>
                  <tr>
                    <td>Hidratos de carbono</td>
                    <td><input id="hidratosDeCarbono" class="input" type="text" 
                        value="<%= datosSesion?.manejoNutricional?.hidratosDeCarbono || '' %>" required/></td>
                  </tr>
                  <tr>
                    <td>Lípidos</td>
                    <td><input id="lipidos" class="input" type="text" name="manejo[Lípidos]" placeholder="..." 
                      value="<%= datosSesion?.manejoNutricional?.lipidos || '' %>" required/></td>
                  </tr>
                  <tr>
                    <td>Proteínas</td>
                    <td><input id="proteinas" class="input" type="text" name="manejo[Proteínas]" placeholder="..." 
                      value="<%= datosSesion?.manejoNutricional?.proteinas || '' %>" required/></td>
                  </tr>
                  <tr>
                    <td>Fibra</td>
                    <td><input id="fibra" class="input" type="text" name="manejo[Fibra]" placeholder="..."
                      value="<%= datosSesion?.manejoNutricional?.fibra || '' %>" required/></td>
                  </tr>
                  <tr>
                    <td>Agua</td>
                    <td><input id="agua" class="input" type="text" name="manejo[Agua]" placeholder="..." 
                      value="<%= datosSesion?.manejoNutricional?.agua || '' %>" required/></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Paginación -->
    <div class="entrevista-pagination has-text-centered mt-4">
      <nav class="pagination is-centered" role="navigation" aria-label="pagination">
        <ul class="pagination-list">
          <% for(let i = 1; i <= 2; i++) { %>
            <li>
              <a class="pagination-link <%= i === 1 ? 'is-current' : '' %>" 
                data-page="<%= i %>" 
                aria-label="Ir a página <%= i %>">
                <%= i %>
              </a>
            </li>
          <% } %>
        </ul>
      </nav>
    </div>
  </main>

  <script src="/js/historiaClinicaV2.js"></script>
</body>
</html>