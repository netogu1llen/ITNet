<%- include('partials/head') %>

<body>
  <div class="container">
    <main class="content">
      <!-- Encabezado con información del expediente -->
      <div class="box">
        <div class="logo-title">
          <img src="/images/manzana.png" alt="Logo Nutrición" class="logo-img">
          <h1>Historia Clínica - Seguimiento
            <button class="btn-guardar button is-success" type="submit" style="float: right;">
              <%= datosSesion ? 'Actualizar' : 'Guardar' %>
            </button>
          </h1>
        </div>
        
        <div class="info-top">
          <div class="columns">
            <div class="column">
              <strong>No. Expediente:</strong> <%= expediente.IDExpediente %>
            </div>
            <div class="column">
              <strong>Sesión:</strong>
              <input id="numSesion" type="text" class="input" 
                value="<%= datosSesion?.numSesion || '' %>"
                <%= datosSesion ? 'readonly' : '' %>
                style="width: 60px; display: inline-block;">
            </div>
            <div class="column">
              <strong>Fecha:</strong> <%= new Date().toLocaleDateString('es-ES') %>
            </div>
          </div>
        </div>
      </div>

      <!-- Datos del paciente -->
      <section class="box">
        <h2 class="subtitle">Datos del Paciente</h2>
        <div class="columns is-multiline">
          <div class="column is-half">
            <strong>Nombre Completo:</strong> 
            <%= expediente.nombres %> <%= expediente.apellidoP %> <%= expediente.apellidoM %>
          </div>
          <div class="column is-half">
            <strong>Fecha de Nacimiento:</strong> 
            <%= expediente.fechaNacimiento %>
          </div>
          <!-- Add more patient data as needed -->
        </div>
      </section>

      <!-- Datos de la última sesión V1 -->
      <section class="box">
        <h2 class="subtitle">Última Evaluación (V1)</h2>
        <div class="columns is-multiline">
          <div class="column is-half">
            <strong>Peso anterior:</strong> 
            <%= datosSesionV1?.evaluacionAntropometrica?.peso || 'No registrado' %> kg
          </div>
          <div class="column is-half">
            <strong>Talla anterior:</strong> 
            <%= datosSesionV1?.evaluacionAntropometrica?.talla || 'No registrado' %> m
          </div>
        </div>
      </section>

      <!-- Nueva evaluación -->
      <section class="box">
        <h2 class="subtitle">Evaluación Actual</h2>
        
        <!-- Medidas antropométricas -->
        <div class="field">
          <label class="label">Peso actual (kg)</label>
          <div class="control">
            <input class="input" type="number" step="0.1" id="pesoActual" required>
          </div>
        </div>

        <div class="field">
          <label class="label">Talla actual (m)</label>
          <div class="control">
            <input class="input" type="number" step="0.01" id="tallaActual" required>
          </div>
        </div>

        <!-- IMC se calculará automáticamente -->
        <div class="field">
          <label class="label">IMC</label>
          <div class="control">
            <input class="input" type="text" id="imc" readonly>
          </div>
        </div>

        <!-- Observaciones -->
        <div class="field">
          <label class="label">Observaciones</label>
          <div class="control">
            <textarea class="textarea" id="observaciones" placeholder="Ingrese sus observaciones aquí..."></textarea>
          </div>
        </div>
      </section>

      <!-- Botones de navegación -->
      <div class="buttons is-centered">
        <button class="button is-light" onclick="history.back()">Cancelar</button>
        <button class="button is-success btn-guardar">Guardar</button>
      </div>
    </main>
  </div>

  <script src="/js/historiaClinicaV2.js"></script>
</body>
</html>
