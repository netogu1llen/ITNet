                        <br>
                        <div class="basic-black">Pablo Picapiedra</div>
                    </div>
                    <div class="element-container">
                        <div class="basic-gray"> >Grado que cursa</div>
                        <br>
                        <div class="basic-black">6 de primaria</div>
                    </div>
                    <div class="element-container">
                        <div class="basic-gray"> >Peso</div>
                        <br>
                        <div class="basic-black">50kg</div>
                    </div>
                </div>
                <br>
                <div class="basic-gray">Objetivo de la sesion:</div>
                <div class="multirow-form-container">
                    <textarea name="objetivo" required rows="4" required></textarea>
                </div>
                <div class="basic-gray">Justificacion de la sesion:</div>
                <div class="multirow-form-container">
                    <textarea name="objetivo" required rows="4" required></textarea>
                </div>
                <table class="multirow-table">
                    <thead>
                        <tr>
                            <th>Actividad</th>
                            <th>Tiempo</th>
                            <th>Metodología</th>
                            <th>Objetivo</th>
                            <th>Observaciones</th>
                        </tr>
                    </thead>
                    <tbody id="table">
                        <tr>
                            <td>
                                <div class="multirow-form-container">
                                    <textarea name="actividad" required rows="4" required></textarea>
                                </div>
                            </td>
                            <td>
                                <div class="multirow-form-container">
                                    <textarea name="tiempo" required rows="4" required></textarea>
                                </div>
                            </td>
                            <td>
                                <div class="multirow-form-container">
                                    <textarea name="metodologia" required rows="4" required></textarea>
                                </div>
                            </td>
                            <td>
                                <div class="multirow-form-container">
                                    <textarea name="objetivoActividad" required rows="4" required></textarea>
                                </div>
                            </td>
                            <td>
                                <div class="multirow-form-container">
                                    <textarea name="observaciones" required rows="4" required></textarea>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
                
                <button id="btn-agregar-fila" class="button is-save">
                    ＋
                </button>

                <div class="basic-gray">Analisis psicológico:</div>
                <div class="multirow-form-container">
                    <textarea name="objetivo" required rows="4" required></textarea>
                </div>
                <div class="basic-gray">Recomendaciones:</div>
                <div class="multirow-form-container">
                    <textarea name="objetivo" required rows="4" required></textarea>
                </div>
                <div class="basic-gray">Bitácora de sesión:</div>
                <div class="multirow-form-container">
                    <textarea name="objetivo" required rows="4" required></textarea>
                </div>
            </div>
            </div>
