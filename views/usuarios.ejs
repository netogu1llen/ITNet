<%- include('partials/head') %>
<link rel="stylesheet" href="/styles.css">

<section class="section" data-current-user-id="<%= user.userId %>">
  <div class="container">
    <h1 class="title">Usuarios</h1>

    <!-- Contenedor para la barra superior -->
    <div id="usuariosTopBar" class="dt-top-bar">
      <!-- La imagen, el selector de registros, la barra de búsqueda y el botón de registrar se agregarán dinámicamente desde usuarios.js -->
    </div>

    <!-- Tabla -->
    <div style="width: 100%; height: 900px;">
      <table id="miEquipoTable" class="table is-striped is-hoverable is-fullwidth">
        <thead>
          <tr>
            <th>Nombre Completo</th>
            <th>Correo</th>
            <th>Fecha de Nacimiento</th>
            <th>Rol</th>
            <th>Eliminar</th>
          </tr>
        </thead>
        <tbody>
          <% usuarios.forEach(usuario => { %>
            <tr class="usuario-fila" data-id="<%= usuario.IDUsuario %>" style="cursor: pointer;">
              <td><%= `${usuario.nombres} ${usuario.apellidoP} ${usuario.apellidoM || ''}`.trim() %></td>
              <td><%= usuario.correo %></td>
              <td>
                <% if (usuario.fechaNacimiento) { %>
                  <%= usuario.fechaNacimiento %>
                <% } else { %>
                  Sin fecha
                <% } %>
              </td>
              <td>
                <div class="select-rol-container">
                  <select class="select-rol" data-id="<%= usuario.IDUsuario %>" <% if (usuario.IDUsuario === user.userId) { %> disabled title="No puedes cambiar tu propio rol" <% } %>>
                    <option value="0">Sin rol</option>
                    <% roles.forEach(rol => { %>
                      <option value="<%= rol.IDRol %>" <%= usuario.rol === rol.Tipo ? 'selected' : '' %>><%= rol.Tipo %></option>
                    <% }) %>
                  </select>
                </div>
              </td>
              <td>
                <button class="button is-small is-danger btn-eliminar" data-id="<%= usuario.IDUsuario %>" 
                  <% if (usuario.IDUsuario === user.userId) { %> disabled title="No puedes eliminar tu propia cuenta" <% } %>>Eliminar</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Modal de Modificar Usuario -->
<div id="modalModificar" class="modal" style="display: none; z-index: 1050;">
    <!-- Fondo oscuro -->
    <div class="modal-background" style="background-color: rgba(0, 0, 0, 0.8);"></div>
  
    <!-- Contenedor principal del modal -->
    <div class="modal-card" style="width: 600px; max-height: 700px;">
      
      <!-- Cabecera con botón de cierre (X) -->
      <header class="modal-card-head" style="border-bottom: none; justify-content: flex-end; background-color: white;">
        <button class="delete" aria-label="close"></button>
      </header>
  
      <!-- Cuerpo del modal -->
      <section class="modal-card-body" style="text-align: center;">
        <!-- Ícono e título centrados -->
        <div style="margin-bottom: 20px;">
          <img src="/images/modificarusuario.png" alt="Icono de usuario" style="width: 100px; height: 100px;">
        </div>
        <h1 class="title" style="margin-bottom: 30px;">Modificar Usuario</h1>
  
        <!-- Formulario con filas para los campos -->
        <form id="modificarForm" method="post">
          <div class="columns">
            <!-- Columna 1: Nombres -->
            <div class="column">
              <div class="field">
                <label class="label">Nombres:</label>
                <div class="control">
                    <input class="input" type="text" name="nombresMod" maxlength="100" required pattern="[A-Za-záéíóúÁÉÍÓÚüÜñÑ\s]+" title="Se permiten letras, acentos y espacios">
                </div>
              </div>
            </div>
            <!-- Columna 2: Apellido Paterno -->
            <div class="column">
              <div class="field">
                <label class="label">Apellido Paterno:</label>
                <div class="control">
                    <input class="input" type="text" name="apellidoPMod" maxlength="60" required pattern="[A-Za-záéíóúÁÉÍÓÚüÜñÑ\s]+" title="Se permiten letras, acentos y espacios">
                </div>
              </div>
            </div>
          </div>
  
          <div class="columns">
            <!-- Columna 1: Apellido Materno -->
            <div class="column">
              <div class="field">
                <label class="label">Apellido Materno:</label>
                <div class="control">
                    <input class="input" type="text" name="apellidoMMod" maxlength="60" pattern="[A-Za-záéíóúÁÉÍÓÚüÜñÑ\s]*" title="Se permiten letras, acentos y espacios">
                </div>
              </div>
            </div>
            <!-- Columna 2: Fecha de Nacimiento -->
            <div class="column">
              <div class="field">
                <label class="label">Fecha de Nacimiento:</label>
                <div class="control">
                  <input class="input" type="date" name="fechaNacimientoMod" required>
                </div>
              </div>
            </div>
          </div>
          
          <div class="columns">
            <!-- Columna: Correo -->
            <div class="column">
              <div class="field">
                <label class="label">Correo:</label>
                <div class="control">
                  <input class="input" type="email" name="correoMod" maxlength="50" required title="Ingrese un correo electrónico válido">
                </div>
              </div>
            </div>
            <div class="column">
              <div class="field">
                <label class="label">Rol:</label>
                <div class="control">
                  <div class="select is-fullwidth">
                    <select name="idRolMod">
                      <option value="0">Sin rol</option>
                      <% roles.forEach(rol => { %>
                        <option value="<%= rol.IDRol %>"><%= rol.Tipo %></option>
                      <% }) %>
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </form>
      </section>
  
      <!-- Footer con botones -->
      <footer class="modal-card-foot" style="justify-content: center; background-color: white;">
        <button type="button" class="button is-cancel">Cancelar</button>
        <button type="submit" form="modificarForm" class="button is-save">Modificar Usuario</button>
      </footer>
    </div>
</div>

