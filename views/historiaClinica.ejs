                    <label class="label">Nombre Completo</label>
                    <input class="input" type="text" 
                          name="expediente[nombreCompleto]" 
                          value="<%= expediente.nombres %> <%= expediente.apellidoP %> <%= expediente.apellidoM %>" 
                          readonly/>
                  </div>
                </div>

                <div class="columns">
                  <div class="column">
                    <label class="label">Grado</label>
                    <input class="input" type="text" 
                          name="expediente[grado]" 
                          value="<%= expediente.grado %>" 
                          readonly/>
                  </div>

                  <div class="column">
                    <label class="label">Nivel Escolar</label>
                    <input class="input" type="text" 
                          name="expediente[nvEscolar]" 
                          value="<%= expediente.nvEscolar %>" 
                          readonly/>
                  </div>
                </div>

                <div class="columns">
                  <div class="column">
                    <label class="label">Fecha de nacimiento</label>
                    <input class="input" type="date" 
                    name="expediente[fechaNacimiento]" 
                    value="<%= expediente.fechaNacimiento.replace(/\//g, '-') %>" 
                    readonly/>
                  
                  </div>

                  <div class="column">
                    <label class="label">Edad (años)</label>
                    <%function calcularEdad(fechaNacimiento) {if (!fechaNacimiento) return '';const hoy = new Date();const nacimiento = new Date(fechaNacimiento);let edad = hoy.getFullYear() - nacimiento.getFullYear();const m = hoy.getMonth() - nacimiento.getMonth();if (m < 0 || (m === 0 && hoy.getDate() < nacimiento.getDate())) {edad--;
                          }
                          return edad;
                        }
                      %>
                    <input class="input" type="number" 
                          name="expediente[edad]" 
                          value="<%= calcularEdad(expediente.fechaNacimiento) %>" 
                          readonly/>
                  </div>
