            <!-- VII. INDICADORES BIOQUÍMICOS -->
            <div class="container">
              <table class="table is-fullwidth" style="border-collapse: collapse; border-radius: 10px; overflow: hidden;">
                <thead>
                  <tr>
                    <th colspan="3" class="has-text-black" style="text-align: center; background-color:#f2f2f2;">VII. INDICADORES BIOQUÍMICOS</th>
                  </tr>
                  <tr>
                    <th>Parámetro Bioquímico</th>
                    <th>Valor de referencia</th>
                    <th>Fecha</th>
                  </tr>
                </thead>
                <tbody>
                  <% for (let i = 0; i < 4; i++) { %>
                  <tr>
                    <td><input class="input" type="text" placeholder="Parámetro..."/></td>
                    <td><input class="input" type="text" placeholder="Valor de referencia..."/></td>
                    <td><input class="input" type="date"/></td>
                  </tr>
                  <% } %>
                </tbody>
              </table>
            </div>

            <!-- VIII. EVALUACIÓN ANTROPOMÉTRICA -->
            <div class="container">
              <table class="table is-fullwidth" style="border-collapse: collapse; border-radius: 10px; overflow: hidden;">
                <thead>
                  <tr>
                    <th colspan="3" class="has-text-black" style="text-align: center; background-color:#f2f2f2;">VIII. EVALUACIÓN ANTROPOMÉTRICA</th>
                  </tr>
                  <tr>
                    <th>Aspectos por evaluar</th>
                    <th>Medidas</th>
                    <th>Observaciones</th>
                  </tr>
                </thead>
                <tbody>
                  <% const aspectos = [
                    'Talla (m)',
                    'Edad (a)',
                    'Peso (kg)',
                    'Peso ideal o ajustado (kg)',
                    'IMC (kg/m2)',
                    'Percentil de IMC',
                    'Circunferencia cintura (cm)',
                    'Circunferencia cadera (cm)',
                    'Índice cintura/cadera',
                    'ICT'
                  ]; %>
                  <% aspectos.forEach(aspecto => { %>
                  <tr>
                    <td><%= aspecto %></td>
                    <td><input class="input" type="text" name="medida[<%= aspecto %>]" placeholder="Medida..." /></td>
                    <td><input class="input" type="text" name="observacion[<%= aspecto %>]" placeholder="Observaciones..." /></td>
                  </tr>
                  <% }); %>
                </tbody>
                
              </table>
            </div>

            <!-- IX. DIAGNÓSTICO Y EVOLUCIÓN DEL PACIENTE -->
            <div class="container">
              <table class="table is-fullwidth" style="border-collapse: collapse; border-radius: 10px; overflow: hidden;">
                <thead>
                  <tr>
                    <th colspan="2" class="has-text-black" style="text-align: center; background-color:#f2f2f2;">IX. DIAGNÓSTICO Y EVOLUCIÓN DEL PACIENTE</th>
                  </tr>
                </thead>
                <tbody>

                  <tr>
                    <td class="has-text-weight-semibold">Diagnóstico y evolución:</td>
                    <td><textarea class="textarea" placeholder="Diagnósticos secundarios..."></textarea></td>
                  </tr>

                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

    

    <!-- Página 4 -->
    <div class="entrevista-pagina" style="display: none;">
      <div class="box" style="background-color: #f2f2f2;">
        <h1 class="has-text-black pl-6">
          <img src="/images/manzana.png" style="height: 30px;">
          Historia Clínica
        </h1>
        <div class="pl-6">
          <div class="box" style="background-color: #ffffff;">
            <div class="container">
              <table class="table is-fullwidth" style="border-collapse: collapse; border-radius: 10px; overflow: hidden;">
                <thead>
                  <tr>
                    <th class="has-text-black" style="text-align: center; background-color:#f2f2f2;">X. OBJETIVOS NUTRICIONALES</th>
                  </tr>
                </thead>
                <tbody>
                  <% for (let i = 0; i < 6; i++) { %>
                  <tr>
                    <td><input class="input" type="text" placeholder="Objetivos..."/></td>
                  </tr>
                  <% } %>
                </tbody>
              </table>
            </div>

            <div class="container">
              <table class="table is-fullwidth" style="border-collapse: collapse; border-radius: 10px; overflow: hidden;">
                <thead>
                  <tr>
                    <th colspan="2" class="has-text-black" style="text-align: center; background-color:#f2f2f2;">XI. MANEJO NUTRICIONAL</th>
                  </tr>
                </thead>
                <tbody>
                  <% const manejo = ['Energía (kcal)', 'Hidratos de carbono', 'Lípidos', 'Proteínas', 'Fibra', 'Agua']; %>
                  <% manejo.forEach(m => { %>
                  <tr>
                    <td><%= m %></td>
                    <td><input class="input" type="text" placeholder="..."/></td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
    

    <!-- Paginación -->
    <div class="entrevista-pagination">
      <%- include('partials/pagination', { totalPaginas: 4, paginaActual: 1 }) %>
    </div>
  </main>
</body>
</html>

