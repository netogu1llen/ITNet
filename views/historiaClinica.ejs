                No. Expediente: <%= expediente.IDExpediente %>
              </div>
              <div class="column has-text-black has-text-weight-semibold">
                <label> Numero de sesión:</label>

                <input id="numSesion" class="input" type="text" required
                    value="<%= datosSesion?.nutricional1?.numSesion || '' %>" 
                    <%= datosSesion ? 'readonly' : '' %> 
                    style="width: 20%; border: 0;" />

              </div>

            </div>
            <hr class="has-background-grey-lighter">
            
            <!-- PARTE UNO -->
