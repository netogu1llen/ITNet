                        <thead>
                          <tr>
                            <th colspan="3" class="has-text-black" style="border: 1px solid #ddd; padding: 8px; text-align: center; background-color:#f2f2f2; border-top-left-radius: 10px; border-top-right-radius: 10px;">
                              VI. ACTIVIDAD DIARIA
                            </th>
                          </tr>
                        </thead>
                      </table>
                      <div class="columns">
                         
                          <div class="column pr-6">
                              <div class="columns is-vcentered">
                                  
                                  <div class="column is-half">
                                    <label class="label" style="margin-left: 10%;">¿Realiza ejercicio físico? Sí/No</label>
                                    <div class="control">
                                      <input id="ejercicioFisico" class="input" type="text" 
                                          value="<%= datosSesion?.actividadDiaria?.ejercicioFisico || '' %>" />
                                    </div>
                                  </div>
                                
                                  <% 
                                    const fechaInicioFormateada = datosSesion?.actividadDiaria?.fechaInicio 
                                      ? new Date(datosSesion.actividadDiaria.fechaInicio).toISOString().split('T')[0] 
                                      : '';
                                  %>
                                  <div class="column is-half">
                                    <label class="label">Fecha de Inicio</label>
                                    <div class="control">
                                      <input 
                                        id="fechaInicio" 
                                        class="input" 
                                        type="date" 
                                        value="<%= fechaInicioFormateada %>" 
                                      />
                                    </div>
                                  </div>
                                </div>
  
                            <div class="columns">
                              <div class="column">Frecuencia<input id="frecuencia" class="input" type="text" 
                                  value="<%= datosSesion?.actividadDiaria?.frecuencia || '' %>" /></div>
                           </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

    <!-- Página 3 -->
    <div class="entrevista-pagina" style="display: none;">
      <div class="box" style="background-color: #f2f2f2;">
        <h1 class="has-text-black pl-6">
          <img src="/images/manzana.png" alt="Salud Icon" style="height: 30px;">
          Historia Clínica
          <button class="btn-guardar button is-success" type="submit" style="margin-left: 75%; margin-bottom: 10px;">
            <%= datosSesion ? 'Actualizar' : 'Guardar' %>
          </button>
        </h1>
        <div class="pl-6">
          <div class="box" style="background-color: #ffffff;">
            <hr class="has-background-grey-lighter">

            <!-- VII. INDICADORES BIOQUÍMICOS -->
            <div class="container">
              <table class="table is-fullwidth" style="border-collapse: collapse; border-radius: 10px; overflow: hidden;">
                <thead>
                  <tr>
                    <th colspan="4" class="has-text-black" style="text-align: center; background-color:#f2f2f2;">
                      VII. INDICADORES BIOQUÍMICOS
                    </th>
                  </tr>
                  <tr>
                    <th>Parámetro Bioquímico</th>
                    <th>Valor de referencia</th>
                    <th>Fecha</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody id="tabla-indicadores">
                  <% if (datosSesion?.indicadoresBioquim?.length > 0) { %>
                    <% datosSesion.indicadoresBioquim.forEach(indicador => { %>
                      <% 
                        const fechaIndicador = indicador.parametroFecha 
                          ? new Date(indicador.parametroFecha).toISOString().split('T')[0] 
                          : '';
                      %>
                      <tr>
                        <td>
                          <input class="input" type="text" name="parametroBioquimico[]" 
                            value="<%= indicador.parametro %>" placeholder="Parámetro..." required>
                        </td>
                        <td>
                          <input class="input" type="text" name="valorReferencia[]" 
                            value="<%= indicador.valorReferencia %>" placeholder="Valor de referencia..." required>
                        </td>
                        <td>
                          <input class="input" type="date" name="fechaParametro[]" 
                            value="<%= fechaIndicador %>" required>
                        </td>
                        <td>
                          <button type="button" class="button is-danger btn-eliminar-fila">-</button>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <!-- Fila por defecto cuando no hay datos -->
                    <tr>
                      <td>
                        <input class="input" type="text" name="parametroBioquimico[]" placeholder="Parámetro..." required>
                      </td>
                      <td>
                        <input class="input" type="text" name="valorReferencia[]" placeholder="Valor de referencia..." required>
                      </td>
                      <td>
                        <input class="input" type="date" name="fechaParametro[]" required>
                      </td>
                      <td>
                        <button type="button" class="button is-danger btn-eliminar-fila">-</button>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>

              <div class="has-text-centered">
                <button id="btn-agregar-fila" class="button is-success" type="button">
                  ＋ Agregar parámetro
                </button>
              </div>
            </div>

            <!-- VIII. EVALUACIÓN ANTROPOMÉTRICA -->
            <div class="container">
              <table class="table is-fullwidth" style="border-collapse: collapse; border-radius: 10px; overflow: hidden;">
                <thead>
                  <tr>
                    <th colspan="3" class="has-text-black" style="text-align: center; background-color:#f2f2f2;">VIII. EVALUACIÓN ANTROPOMÉTRICA</th>
                  </tr>
                  <tr>
                    <th>Aspectos por evaluar</th>
                    <th>Medidas</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Altura (m)</td>
                    <td><input id="talla" class="input" type="text" required
                        value="<%= datosSesion?.evaluacionAntropometrica?.talla || '' %>" /></td>
                  </tr>
                  <tr>
                    <td>Peso (kg)</td>
                    <td><input id="peso" class="input" type="text" required
                        value="<%= datosSesion?.evaluacionAntropometrica?.peso || '' %>" /></td>
                  </tr>
                  <tr>
                    <td>Circunferencia cintura (cm)</td>
                    <td><input id="circunferenciaCintura" class="input" type="text" name="medida[Circunferencia cintura (cm)]" placeholder="Medida..."
                      value="<%= datosSesion?.evaluacionAntropometrica?.circunferenciaCintura || '' %>" /></td>
                  </tr>
                  <tr>
                    <td>Circunferencia cadera (cm)</td>
                    <td><input id="circunferenciaCadera" class="input" type="text" name="medida[Circunferencia cadera (cm)]" placeholder="Medida..."
                      value="<%= datosSesion?.evaluacionAntropometrica?.circunferenciaCadera || '' %>" /></td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- IX. DIAGNÓSTICO Y EVOLUCIÓN DEL PACIENTE -->
            <div class="container">
              <table class="table is-fullwidth" style="border-collapse: collapse; border-radius: 10px; overflow: hidden;">
                <thead>
                  <tr>
                    <th colspan="2" class="has-text-black" style="text-align: center; background-color:#f2f2f2;">IX. DIAGNÓSTICO Y EVOLUCIÓN DEL PACIENTE</th>
                  </tr>
                </thead>
                <tbody>

                  <tr>
                    <td class="has-text-weight-semibold">Diagnósticos secundarios:</td>
                    <td><input id="diagnosticoEvolucion"class="input" placeholder="Diagnósticos secundarios..."
                      value="<%= datosSesion?.diagnosticoEvolucion?.diagnosticoEvolucion || '' %>" /></td>
                  
                  </tr>

                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

    

    <!-- Página 4 -->
    <div class="entrevista-pagina" style="display: none;">
      <div class="box" style="background-color: #f2f2f2;">
        <h1 class="has-text-black pl-6">
          <img src="/images/manzana.png" style="height: 30px;">
          Historia Clínica
          <button class="btn-guardar button is-success" type="submit"  style="margin-left: 75%; margin-bottom: 10px;">
            <%= datosSesion ? 'Actualizar' : 'Guardar' %>
          </button>
        </h1>
        <div class="pl-6">
          <div class="box" style="background-color: #ffffff;">
            <div class="container">
              <table class="table is-fullwidth" style="border-collapse: collapse; border-radius: 10px; overflow: hidden;">
                <thead>
                  <tr>
                    <th class="has-text-black" style="text-align: center; background-color:#f2f2f2;">
                      X. OBJETIVOS NUTRICIONALES
                    </th>
                  </tr>
                  <tr>
                    <th>Objetivo</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody id="tabla-objetivos">
                  <% if (datosSesion?.objetivoNutricional?.length > 0) { %>
                    <% datosSesion.objetivoNutricional.forEach(objetivo => { %>
                      <tr>
                        <td>
                          <input class="input" type="text" name="objetivosNutricionales[]" 
                            value="<%= objetivo.objetivo %>" placeholder="Objetivo..." required>
                        </td>
                        <td>
                          <button type="button" class="button is-danger btn-eliminar-fila">-</button>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <!-- Fila por defecto cuando no hay datos -->
                    <tr>
                      <td>
                        <input class="input" type="text" name="objetivosNutricionales[]" placeholder="Objetivo..." required>
                      </td>
                      <td>
                        <button type="button" class="button is-danger btn-eliminar-fila">-</button>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            
              <div class="has-text-centered">
                <button id="btn-agregar-fila-objetivos" class="button is-success" type="button">
                  ＋ Agregar objetivo
                </button>
              </div>
            </div>
            

            <div class="container">
              <table class="table is-fullwidth" style="border-collapse: collapse; border-radius: 10px; overflow: hidden;">
                <thead>
                  <tr>
                    <th colspan="2" class="has-text-black" style="text-align: center; background-color:#f2f2f2;">XI. MANEJO NUTRICIONAL</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Energía (kcal)</td>
                    <td><input id="energia" class="input" type="text" 
                        value="<%= datosSesion?.manejoNutricional?.energia || '' %>" /></td>
                  </tr>
                  <tr>
                    <td>Hidratos de carbono</td>
                    <td><input id="hidratosDeCarbono" class="input" type="text" 
                        value="<%= datosSesion?.manejoNutricional?.hidratosDeCarbono || '' %>" /></td>
                  </tr>
                  <tr>
                    <td>Lípidos</td>
                    <td><input id="lipidos" class="input" type="text" name="manejo[Lípidos]" placeholder="..." 
                      value="<%= datosSesion?.manejoNutricional?.lipidos || '' %>"/></td>
                  </tr>
                  <tr>
                    <td>Proteínas</td>
                    <td><input id="proteinas" class="input" type="text" name="manejo[Proteínas]" placeholder="..." 
                      value="<%= datosSesion?.manejoNutricional?.proteinas || '' %>"/></td>
                  </tr>
                  <tr>
                    <td>Fibra</td>
                    <td><input id="fibra" class="input" type="text" name="manejo[Fibra]" placeholder="..."
                      value="<%= datosSesion?.manejoNutricional?.fibra || '' %>" /></td>
                  </tr>
                  <tr>
                    <td>Agua</td>
                    <td><input id="agua" class="input" type="text" name="manejo[Agua]" placeholder="..." 
                      value="<%= datosSesion?.manejoNutricional?.agua || '' %>"/></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
    

    <!-- Paginación -->
    <div class="entrevista-pagination">
      <%- include('partials/pagination', { totalPaginas: 4, paginaActual: 1 }) %>
    </div>
  </main>
  <script src="/js/historiaClinica.js"></script>

</body>
</html>

