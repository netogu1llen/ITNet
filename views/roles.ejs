<%- include('partials/head') %>
<link rel="stylesheet" href="/styles.css">

<section class="section">
  <div class="container">
    <h1 class="title">Roles</h1>

    <!-- Contenedor para la barra superior -->
    <div id="usuariosTopBar" class="dt-top-bar">
      <!-- La imagen, el selector de registros, la barra de búsqueda y el botón de registrar se agregarán dinámicamente desde usuarios.js -->
    </div>

    <!-- Tabla -->
    <div style="width: 100%; height: 900px;">
      <table id="roles" class="table is-striped is-hoverable is-fullwidth">
        <thead>
          <tr>
            <th>Rol</th>
            <th>Modificar</th>
            <th>Eliminar</th>
          </tr>
        </thead>
        <tbody>
          <% roles.forEach(rol => { %>
            <tr>
              <td><%= rol.Tipo %></td>
              <td>
                <button class="button is-small is-info btn-modificar" data-id="<%= rol.IDRol %>">Modificar</button>
              </td>
              <td>
                <button class="button is-small is-danger btn-eliminar" data-id="<%= rol.IDRol %>">Eliminar</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- Scripts -->
<script src="/vendor/jquery-3.6.0.min.js"></script>
<script src="/vendor/jquery.dataTables.min.js"></script>
<script src="/js/usuarios.js"></script>
