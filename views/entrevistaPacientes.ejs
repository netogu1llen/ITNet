<%- include('partials/head') %>
<link rel="stylesheet" href="styles.css">
<body>
    <div class="container">
        <div class="entrevista-container">
            <!-- Encabezado -->
            <header class="entrevista-header">
                <h1 class="entrevista-title">
                    <img src="/images/psicologia.png" width="45" height="45" alt="Psicología" class="header-icon">
                    Entrevista para adulto
                </h1>
                <div class="entrevista-info">
                    <p><strong>Larissa Jiménez Aldemar</strong></p>
                    <p><strong>No. Expediente:</strong> 34</p>
                    <p><strong>Hora:</strong> 16:45</p>
                    <p><strong>Fecha:</strong> 01 de marzo de 2025</p>
                </div>
            </header>

            <!-- Página 1 (visible por defecto) -->
            <div id="pagina-1" class="entrevista-pagina">
                <!-- Sección de Datos Generales -->
                <section class="entrevista-section">
                    <h2 class="entrevista-section-title">I. Datos Generales</h2>
                    <div class="entrevista-grid">
                        <div>
                            <label>Nombre Completo</label>
                            <input type="text" class="entrevista-input" name="nombre_completo" required>
                        </div>
                        <div>
                            <label>Edad</label>
                            <input type="number" class="entrevista-input" name="edad" min="18" max="120">
                        </div>
                        <div>
                            <label>Sexo</label>
                            <select class="entrevista-select" name="sexo" required>
                                <option value="" disabled selected>Seleccione</option>
                                <option value="Masculino">Masculino</option>
                                <option value="Femenino">Femenino</option>
                                <option value="Otro">Otro</option>
                            </select>
                        </div>
                        <div>
                            <label>Ocupación</label><input type="text" class="entrevista-input" name="ocupacion">
                        </div>
                        <div>
                            <label>Escolaridad</label><input type="text" class="entrevista-input" name="escolaridad">
                        </div>
                        <div>
                            <label>Domicilio</label><input type="text" class="entrevista-input" name="domicilio">
                        </div>
                        <div>
                            <label>Motivo de consulta</label><input type="text" class="entrevista-input" name="motivo">
                        </div>
                        <div>
                            <label>Teléfono</label><input type="tel" class="entrevista-input" name="telefono">
                        </div>
                        <div>
                            <label>Remitido por</label><input type="text" class="entrevista-input" name="remitido_por">
                        </div>
                    </div>
                </section>

                <!-- Sección del Psicograma -->
                <section class="entrevista-section">
                    <h2 class="entrevista-section-title">II. Psicograma</h2>
                    <table class="entrevista-table">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Parentesco</th>
                                <th>Edad</th>
                                <th>Ocupación</th>
                                <th>Escolaridad</th>
                                <th>Carácter</th>
                                <th>Sentimiento</th>
                                <th>Relación</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-psicograma">
                            <tr>
                                <td><input type="text" class="entrevista-input" name="psicograma_nombre[]"></td>
                                <td><input type="text" class="entrevista-input" name="psicograma_parentesco[]"></td>
                                <td><input type="number" class="entrevista-input" name="psicograma_edad[]"></td>
                                <td><input type="text" class="entrevista-input" name="psicograma_ocupacion[]"></td>
                                <td><input type="text" class="entrevista-input" name="psicograma_escolaridad[]"></td>
                                <td><input type="text" class="entrevista-input" name="psicograma_caracter[]"></td>
                                <td><input type="text" class="entrevista-input" name="psicograma_sentimiento[]"></td>
                                <td><input type="text" class="entrevista-input" name="psicograma_relacion[]"></td>
                            </tr>
                        </tbody>
                    </table>
                    <button id="btn-agregar-fila" class="entrevista-btn">
                        ＋
                    </button>
                </section>

                <!-- Sección de Motivos de Consulta -->
                <section class="entrevista-section">
                    <h2 class="entrevista-section-title">III. Motivos de Consulta</h2>
                    <label>Presente virtual. (Frecuencia, duración, intensidad)</label>
                    <textarea class="entrevista-textarea" name="motivos_consulta" placeholder="¿Qué fue lo último que ocurrió para que decidiera venir al psicólogo?"></textarea>
                </section>
            </div>

            <!-- Página 2 (oculta por defecto) -->
            <div id="pagina-2" class="entrevista-pagina" style="display:none;">
                <!-- Sección de Cuadro Clínico -->
                <section class="entrevista-section">
                    <h2 class="entrevista-section-title">IV. Cuadro Clínico</h2>
                    
                    <div class="entrevista-grid">
                        <div class="full-width">
                            <label>¿Desde cuándo empezó el problema? (presente virtual)</label>
                            <textarea class="entrevista-textarea" name="inicio_problema"></textarea>
                        </div>
                        
                        <div class="full-width">
                            <label>¿Cómo fue la última ocasión en que ocurrió el problema?</label>
                            <textarea class="entrevista-textarea" name="ultima_ocasion"></textarea>
                        </div>
                        
                        <div class="full-width">
                            <label>¿Qué ocurría en su vida antes de que surgiera la situación? (factores desencadenantes)</label>
                            <textarea class="entrevista-textarea" name="contexto_previo"></textarea>
                        </div>
                    </div>
                </section>

                <!-- Sección de Factores Desencadenantes -->
                <section class="entrevista-section">
                    <h2 class="entrevista-section-title">V. Factores Desencadenantes</h2>
                    
                    <label>¿Qué otros aspectos se vinculan con el problema? (núcleo)</label>
                    
                    <table class="entrevista-table">
                        <thead>
                            <tr>
                                <th>Factor Asociado</th>
                                <th>Descripción</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Familia</td>
                                <td><input type="text" class="entrevista-input" name="factor_familia"></td>
                            </tr>
                            <tr>
                                <td>Pareja</td>
                                <td><input type="text" class="entrevista-input" name="factor_pareja"></td>
                            </tr>
                            <tr>
                                <td>Amistades</td>
                                <td><input type="text" class="entrevista-input" name="factor_amistades"></td>
                            </tr>
                            <tr>
                                <td>Escuela</td>
                                <td><input type="text" class="entrevista-input" name="factor_escuela"></td>
                            </tr>
                            <tr>
                                <td>Salud Física</td>
                                <td><input type="text" class="entrevista-input" name="factor_salud"></td>
                            </tr>
                        </tbody>
                    </table>
                </section>
            </div>
            <!-- Página 3 -->
            <div id="pagina-3" class="entrevista-pagina">
                <!-- Sección de Soportes -->
                <section class="entrevista-section">
                    <h2 class="entrevista-section-title">VI. Soporte Familiar, Social, Laboral, Personal (Andamiaje)</h2>
                    
                    <div class="two-columns-container">
                        <!-- Columna izquierda -->
                        <div class="column-left">
                            <div class="input-group">
                                <label>Autovaloración</label>
                                <input type="text" class="entrevista-input" name="autovaloracion">
                            </div>
                            
                            <div class="input-group">
                                <label>Satisfacción conyugal o de pareja:</label>
                                <input type="text" class="entrevista-input" name="satisfaccion_pareja">
                            </div>
                            
                            <div class="input-group">
                                <label>Situaciones con las que se siente tranquilo:</label>
                                <input type="text" class="entrevista-input" name="situaciones_tranquilas">
                            </div>
                        </div>
                        
                        <!-- Columna derecha -->
                        <div class="column-right">
                            <div class="input-group">
                                <label>Sueños y fantasías más frecuentes:</label>
                                <input type="text" class="entrevista-input" name="suenos_fantasias">
                            </div>
                            
                            <div class="input-group">
                                <label>Satisfacción laboral o de estudios:</label>
                                <input type="text" class="entrevista-input" name="satisfaccion_laboral">
                            </div>
                            
                            <div class="input-group">
                                <label>Actividades gratificantes que realiza:</label>
                                <input type="text" class="entrevista-input" name="actividades_gratificantes">
                            </div>
                        </div>
                    </div>
                    
                    <!-- Días de la semana -->
                    <div class="full-width">
                        <label>Describa las actividades que realiza cotidianamente:</label>
                    </div>
                    
                    <div class="two-columns-container">
                        <div class="column-left">
                        <div class="day-input">
                            <label>Lunes:</label>
                            <input type="text" class="entrevista-input" name="actividades_lunes">
                        </div>
                        
                        <div class="day-input">
                            <label>Martes:</label>
                            <input type="text" class="entrevista-input" name="actividades_martes">
                        </div>
                    </div>
                    <div class="column-left">
                        <div class="day-input">
                            <label>Miércoles:</label>
                            <input type="text" class="entrevista-input" name="actividades_miercoles">
                        </div>
                        <div class="day-input">
                            <label>Jueves:</label>
                            <input type="text" class="entrevista-input" name="actividades_jueves">
                        </div>
                    </div>
                    <div class="column-left">
                        <div class="day-input">
                            <label>Viernes:</label>
                            <input type="text" class="entrevista-input" name="actividades_viernes">
                        </div>
                        <div class="day-input">
                            <label>Sábado:</label>
                            <input type="text" class="entrevista-input" name="actividades_sabado">
                        </div>
                        </div>
                        <div class="day-input">
                            <label>Domingo:</label>
                            <input type="text" class="entrevista-input" name="actividades_domingo">
                        </div>
                    </div>
                </section>

                <!-- Sección de Contexto de Vida -->
                <section class="entrevista-section">
                    <h2 class="entrevista-section-title">VII. Contexto de Vida</h2>
                    
                    <table class="entrevista-table contexto-vida">
                        <thead>
                            <tr>
                                <th>Etapa / Aspectos</th>
                                <th>Infancia (0-6)</th>
                                <th>Niñez (6-12)</th>
                                <th>Adolescencia (13) a Juventud (18-35)</th>
                                <th>Adultez (35→)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Salud física</td>
                                <td><input type="text" class="entrevista-input" name="infancia_salud"></td>
                                <td><input type="text" class="entrevista-input" name="ninez_salud"></td>
                                <td><input type="text" class="entrevista-input" name="adolescencia_salud"></td>
                                <td><input type="text" class="entrevista-input" name="adultez_salud"></td>
                            </tr>
                            <tr>
                                <td>Familia</td>
                                <td><input type="text" class="entrevista-input" name="infancia_familia"></td>
                                <td><input type="text" class="entrevista-input" name="ninez_familia"></td>
                                <td><input type="text" class="entrevista-input" name="adolescencia_familia"></td>
                                <td><input type="text" class="entrevista-input" name="adultez_familia"></td>
                            </tr>
                            <tr>
                                <td>Pareja</td>
                                <td><input type="text" class="entrevista-input" name="infancia_pareja"></td>
                                <td><input type="text" class="entrevista-input" name="ninez_pareja"></td>
                                <td><input type="text" class="entrevista-input" name="adolescencia_pareja"></td>
                                <td><input type="text" class="entrevista-input" name="adultez_pareja"></td>
                            </tr>
                            <tr>
                                <td>Amistades</td>
                                <td><input type="text" class="entrevista-input" name="infancia_amistades"></td>
                                <td><input type="text" class="entrevista-input" name="ninez_amistades"></td>
                                <td><input type="text" class="entrevista-input" name="adolescencia_amistades"></td>
                                <td><input type="text" class="entrevista-input" name="adultez_amistades"></td>
                            </tr>
                            <tr>
                                <td>Escuela</td>
                                <td><input type="text" class="entrevista-input" name="infancia_escuela"></td>
                                <td><input type="text" class="entrevista-input" name="ninez_escuela"></td>
                                <td><input type="text" class="entrevista-input" name="adolescencia_escuela"></td>
                                <td><input type="text" class="entrevista-input" name="adultez_escuela"></td>
                            </tr>
                            <tr>
                                <td>Trabajo</td>
                                <td><input type="text" class="entrevista-input" name="infancia_trabajo"></td>
                                <td><input type="text" class="entrevista-input" name="ninez_trabajo"></td>
                                <td><input type="text" class="entrevista-input" name="adolescencia_trabajo"></td>
                                <td><input type="text" class="entrevista-input" name="adultez_trabajo"></td>
                            </tr>
                            <tr>
                                <td>Rasgos de personalidad</td>
                                <td><input type="text" class="entrevista-input" name="infancia_personalidad"></td>
                                <td><input type="text" class="entrevista-input" name="ninez_personalidad"></td>
                                <td><input type="text" class="entrevista-input" name="adolescencia_personalidad"></td>
                                <td><input type="text" class="entrevista-input" name="adultez_personalidad"></td>
                            </tr>
                        </tbody>
                    </table>
                </section>
            </div>

        <!-- Página 4 -->
        <div id="pagina-4" class="entrevista-pagina">
            <!-- Sección de Conclusiones Evidentes -->
            <section class="entrevista-section">
                <h2 class="entrevista-section-title">VIII. Conclusiones Evidentes (Lo que está claro)</h2>
                
                <table class="conclusiones-table">
                    <thead>
                        <tr>
                            <th rowspan="2">Descripción</th>
                            <th colspan="4">Dinámica (explicación)</th>
                        </tr>
                        <tr>
                            <th>Dimensión principal<br>(duración, frecuencia, intensidad)</th>
                            <th>¿Por qué se generó?<br>(Causas, antecedentes históricos)</th>
                            <th>¿Por qué se mantiene?<br>(Factores involucrados)</th>
                            <th>Relación entre los diferentes problemas que se ven</th>
                            <th>Recomendaciones técnicas<br>(sugerencias, etc.)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><input type="text" class="entrevista-input" name="problema1_desc" placeholder="PROBLEMA 1"></td>
                            <td><textarea class="entrevista-textarea" name="problema1_dimension"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="problema1_generacion"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="problema1_mantenimiento"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="problema1_relacion"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="problema1_recomendaciones"></textarea></td>
                        </tr>
                        <tr>
                            <td><input type="text" class="entrevista-input" name="problema2_desc" placeholder="PROBLEMA 2"></td>
                            <td><textarea class="entrevista-textarea" name="problema2_dimension"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="problema2_generacion"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="problema2_mantenimiento"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="problema2_relacion"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="problema2_recomendaciones"></textarea></td>
                        </tr>
                        <tr>
                            <td><input type="text" class="entrevista-input" name="problema3_desc" placeholder="PROBLEMA 3"></td>
                            <td><textarea class="entrevista-textarea" name="problema3_dimension"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="problema3_generacion"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="problema3_mantenimiento"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="problema3_relacion"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="problema3_recomendaciones"></textarea></td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <!-- Sección de Conclusiones Hipotéticas -->
            <section class="entrevista-section">
                <h2 class="entrevista-section-title">IX. Conclusiones Hipotéticas (Lo que hay que cambiar)</h2>
                
                <table class="conclusiones-table">
                    <thead>
                        <tr>
                            <th rowspan="2">Descripción</th>
                            <th colspan="4">Dinámica (explicación)</th>
                        </tr>
                        <tr>
                            <th>Dimensión principal<br>(duración, frecuencia, intensidad)</th>
                            <th>¿Por qué se generó?<br>(Causas, antecedentes históricos)</th>
                            <th>¿Por qué se mantiene?<br>(Factores involucrados)</th>
                            <th>Relación entre los diferentes problemas que se ven   </th>
                            <th>Recomendaciones técnicas<br>(sugerencias, etc.)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><input type="text" class="entrevista-input" name="hipotesis1_desc" placeholder="PROBLEMA 1"></td>
                            <td><textarea class="entrevista-textarea" name="hipotesis1_dimension"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="hipotesis1_generacion"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="hipotesis1_mantenimiento"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="hipotesis1_relacion"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="hipotesis1_recomendaciones"></textarea></td>
                        </tr>
                        <tr>
                            <td><input type="text" class="entrevista-input" name="hipotesis2_desc" placeholder="PROBLEMA 2"></td>
                            <td><textarea class="entrevista-textarea" name="hipotesis2_dimension"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="hipotesis2_generacion"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="hipotesis2_mantenimiento"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="hipotesis2_relacion"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="hipotesis2_recomendaciones"></textarea></td>
                        </tr>
                        <tr>
                            <td><input type="text" class="entrevista-input" name="hipotesis3_desc" placeholder="PROBLEMA 3"></td>
                            <td><textarea class="entrevista-textarea" name="hipotesis3_dimension"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="hipotesis3_generacion"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="hipotesis3_mantenimiento"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="hipotesis3_relacion"></textarea></td>
                            <td><textarea class="entrevista-textarea" name="hipotesis3_recomendaciones"></textarea></td>
                        </tr>
                    </tbody>
                </table>
            </section>
        </div>

        <!-- Paginación Actualizada -->
        <div class="entrevista-pagination">
            <button class="entrevista-page-btn arrow" data-pagina="anterior">&larr;</button>
            <button class="entrevista-page-btn" data-pagina="1">1</button>
            <button class="entrevista-page-btn" data-pagina="2">2</button>
            <button class="entrevista-page-btn" data-pagina="3">3</button>
            <button class="entrevista-page-btn active" data-pagina="4">4</button>
            <button class="entrevista-page-btn arrow" data-pagina="siguiente">&rarr;</button>
        </div>
        </div>
        </div>
<script src="/js/psicologia.js"></script>
</body>