<%- include('partials/head') %>
<link rel="stylesheet" href="/styles.css">

<section class="section">
  <div class="container">
    <h1 class="title">Historiales Clínicos - Nutrición</h1>

    <!-- TopBar dinámica -->
    <div id="nutricionTopBar" class="dt-top-bar"></div>

    <!-- Tabla -->
    <div style="width: 100%; height: 900px;">
      <table id="nutricionTable" class="table is-striped is-hoverable is-fullwidth">
        <thead>
          <tr>
            <th>Nombre del Paciente</th>
            <th>Número de Sesión</th>
            <th>Fecha</th>
            <th>Descargar</th>
            <th>Modificar</th>
            <th>Eliminar</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
</section>

<!-- MODAL REGISTRAR -->
<div id="modalRegistrar" class="modal" style="display: none;">
  <div class="modal-background"></div>
  <div class="modal-card">
    <header class="modal-card-head">
      <p class="modal-card-title">Registrar Paciente</p>
      <button class="delete" aria-label="close"></button>
    </header>
    <section class="modal-card-body">
      <form id="registrarForm" method="post">
        <div class="field">
          <label class="label">Número de Sesión</label>
          <div class="control">
            <input class="input" type="number" name="numSesion" required>
          </div>
        </div>
        <div class="field">
          <label class="label">Fecha</label>
          <div class="control">
            <input class="input" type="date" name="fecha" required>
          </div>
        </div>
      </form>
    </section>
    <footer class="modal-card-foot">
      <button class="button is-cancel">Cancelar</button>
      <button class="button is-success" type="submit" form="registrarForm">Registrar</button>
    </footer>
  </div>
</div>

<!-- MODAL MODIFICAR -->
<div id="modalModificar" class="modal" style="display: none;">
  <div class="modal-background"></div>
  <div class="modal-card">
    <header class="modal-card-head">
      <p class="modal-card-title">Modificar Historial</p>
      <button class="delete" aria-label="close"></button>
    </header>
    <section class="modal-card-body">
      <form id="modificarForm" method="post">
        <input type="hidden" name="idConsulta" id="idConsulta">
        <div class="field">
          <label class="label">Número de Sesión</label>
          <div class="control">
            <input class="input" type="number" name="numSesionMod" id="numSesionMod" required>
          </div>
        </div>
        <div class="field">
          <label class="label">Fecha</label>
          <div class="control">
            <input class="input" type="date" name="fechaMod" id="fechaMod" required>
          </div>
        </div>
      </form>
    </section>
    <footer class="modal-card-foot">
      <button class="button is-cancel">Cancelar</button>
      <button class="button is-warning" type="submit" form="modificarForm">Guardar cambios</button>
    </footer>
  </div>
</div>

<!-- Scripts -->
<script src="/vendor/jquery-3.6.0.min.js"></script>
<script src="/vendor/jquery.dataTables.min.js"></script>
<script src="/js/nutricion.js"></script>
