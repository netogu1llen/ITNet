<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SoffyApp</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="icon" href="<%= process.env.PATH_SERVER %>Images/logo.png" type="image/png">
    <link rel="stylesheet" href="<%= process.env.PATH_SERVER %>styles.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.4/css/bulma.min.css">

</head>
<body>
   <!-- partials/pagination.ejs -->
<nav class="pagination is-centered" role="navigation" aria-label="pagination">
    <a class="pagination-previous" id="pagina-anterior">Anterior</a>
    <a class="pagination-next" id="pagina-siguiente">Siguiente</a>
    <ul class="pagination-list" id="pagination-list">
      <% for(let i = 1; i <= totalPaginas; i++) { %>
        <li>
          <a class="pagination-link <%= paginaActual === i ? 'is-current' : '' %>" 
             aria-label="Goto page <%= i %>"
             data-pagina="<%= i %>">
            <%= i %>
          </a>
        </li>
      <% } %>
    </ul>
  </nav>
  
<script src="<%= process.env.PATH_SERVER %>js/pagination.js"></script> 
</body>
</html>