<%- include('partials/head') %>

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Registrar Boleta</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <section class="contenedor-principal">
    <div class="formulario-boleta">
      <div class="encabezado centrado">
        <img src="/images/regBol.png" alt="Icono boleta">
        <h1>Registrar Boleta</h1>
      </div>
      
      <div class="campo">
        <label for="periodo">Periodo</label>
        <input type="text" id="periodo" placeholder="Ej. Enero 2025 - Marzo 2025">
      </div>

      <div class="tablas">
        <!-- Tabla de materias seleccionadas -->
        <div class="tabla">
          <h3>Materias</h3>
          <table>
            <thead>
              <tr>
                <th>Materia</th>
                <th>Calificación</th>
              </tr>
            </thead>
            <tbody id="tablaMaterias"></tbody>
          </table>
        </div>

        <!-- Checkboxes -->
        <div class="checkboxes">
          <h3>Selecciona las materias</h3>
          <ul>
            <% materias.forEach(m => { %>
              <li>
                <label>
                  <input type="checkbox" class="check-materia" data-materia="<%= m.materia %>">
                  <span><%= m.materia %></span>
                </label>
              </li>
            <% }) %>
          </ul>
        </div>
      </div>

      <div class="boton">
        <button>Guardar Boleta</button>
      </div>
    </div>
  </section>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="/js/boletas.js"></script>
</body>
</html>
