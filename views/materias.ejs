<%- include('partials/head') %>
<link rel="stylesheet" href="/styles.css">

<section class="section">
  <div class="container">
    <h1 class="title">Materias</h1>
    <div style="width: 100%; height: 900px;">
      <table id="materiasTable" class="table is-striped is-hoverable is-fullwidth">
        <thead>
          <tr>
            <th>Materia</th>
            <th>Grado</th>
            <th>Nivel Escolar</th>
            <th>Modificar</th>
            <th>Eliminar</th>
          </tr>
        </thead>
        <tbody>
          <% materias.forEach(m => { %>
            <tr>
              <td><%= m.materia %></td>
              <td><%= m.grado %></td>
              <td><%= m.nvEscolar %></td>
              <td>
                <button class="button is-small is-info btn-modificar" data-id="<%= m.IDMateria %>">Modificar</button>
              </td>
              <td>
                <button class="button is-small is-danger btn-eliminar" data-id="<%= m.IDMateria %>">Eliminar</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- MODAL REGISTRAR -->
<div id="modalRegistrar" class="modal" style="display: none; z-index: 1050;">
  <div class="modal-background"></div>
  <div class="modal-card" style="width: 500px;">
    <header class="modal-card-head">
      <p class="modal-card-title">Registrar Materia</p>
      <button class="delete" aria-label="close"></button>
    </header>
    <section class="modal-card-body">
      <form id="registrarForm">
        <div class="field">
          <label class="label">Materia</label>
          <div class="control">
            <input class="input" type="text" name="materia" required>
          </div>
        </div>
        <div class="field">
          <label class="label">Grado</label>
          <div class="control">
            <input class="input" type="number" name="grado" min="1" max="6" required>
          </div>
        </div>
        <div class="field">
          <label class="label">Nivel Escolar</label>
          <div class="control">
            <input class="input" type="text" name="nvEscolar" required>
          </div>
        </div>
      </form>
    </section>
    <footer class="modal-card-foot">
      <button type="button" class="button is-cancel">Cancelar</button>
      <button type="submit" class="button is-primary" form="registrarForm">Guardar</button>
    </footer>
  </div>
</div>

<!-- MODAL MODIFICAR -->
<div id="modalModificar" class="modal" style="display: none; z-index: 1050;">
  <div class="modal-background"></div>
  <div class="modal-card" style="width: 500px;">
    <header class="modal-card-head">
      <p class="modal-card-title">Modificar Materia</p>
      <button class="delete" aria-label="close"></button>
    </header>
    <section class="modal-card-body">
      <form id="modificarForm">
        <input type="hidden" name="idMateria">
        <div class="field">
          <label class="label">Materia</label>
          <div class="control">
            <input class="input" type="text" name="materia" required>
          </div>
        </div>
        <div class="field">
          <label class="label">Grado</label>
          <div class="control">
            <input class="input" type="number" name="grado" min="1" max="6" required>
          </div>
        </div>
        <div class="field">
          <label class="label">Nivel Escolar</label>
          <div class="control">
            <input class="input" type="text" name="nvEscolar" required>
          </div>
        </div>
      </form>
    </section>
    <footer class="modal-card-foot">
      <button type="button" class="button is-cancel">Cancelar</button>
      <button type="submit" class="button is-primary" form="modificarForm">Guardar Cambios</button>
    </footer>
  </div>
</div>

<!-- JS -->
<script src="/vendor/jquery-3.6.0.min.js"></script>
<script src="/vendor/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/materias.js"></script>
