<%- include('partials/head') %>
<body>
  <!-- Cuerpo del modal -->
  <section class="modal-card-body" style="text-align: center;">
    <!-- Ícono e título centrados -->
    <div style="margin-bottom: 20px;">
      <img src="/images/modificarusuario.png" alt="Icono de usuario" style="width: 100px; height: 100px;">
    </div>
    <h1 class="title" style="margin-bottom: 30px;">Editar Paciente</h1>
    <div class="white-container">
    <div class="full-white-container">
    <div class="multirow-container">
      <div class="element-container"></div>
      <div class="element-container"></div>
      <div class="element-container">
        <label for="IDExpediente">Número de expediente:</label><br>
        <div class="multirow-form-container">
          <input type="text" id="IDExpediente" name="IDExpediente" maxlength="15" value="<%= datos.IDExpediente || '' %>"><br>
        </div>
      </div>
      <div class="element-container"></div>
      <div class="element-container"></div>
    </div>
    <hr>
    <label for="direccion">Datos personales</label>
    <div class="multirow-container">
      <div class="element-container">
        <label for="nombres">Nombres:</label><br>
        <div class="multirow-form-container">
          <input type="text" id="nombres" name="nombres" maxlength="50" value="<%= datos.nombres || '' %>"><br>
        </div>
      </div>

      <div class="element-container">
        <label for="apellidoP">Apellido Paterno:</label><br>
        <div class="multirow-form-container">
          <input type="text" id="apellidoP" name="apellidoP" maxlength="30" value="<%= datos.apellidoP || '' %>"><br>
        </div>
      </div>
      <div class="element-container">
        <label for="apellidoM">Apellido Materno:</label><br>
        <div class="multirow-form-container">
          <input type="text" id="apellidoM" name="apellidoM" maxlength="30" value="<%= datos.apellidoM || '' %>"><br>
        </div>
      </div>
    </div>
    <div class="multirow-container">
      <div class="element-container">
        <label for="fechaNacimiento">Fecha de Nacimiento:</label><br>
        <div class="multirow-form-container">
          <input type="date" id="fechaNacimiento" name="fechaNacimiento"
                 value="<%= datos.fechaNacimiento || '' %>"  max=""><br>
        </div>
      </div>

      <div class="element-container">
        <label for="contacto">Contacto(numero de telefono):</label><br>
        <div class="multirow-form-container">
          <input type="tel" id="contacto" name="contacto" maxlength="10" pattern="[0-9]{10}" title="Ingrese un número de teléfono válido de 10 dígitos" value="<%= datos.contacto || '' %>"><br>
        </div>
      </div>
      <div class="element-container">
        <label for="sexo">Sexo:</label>
        <br>
        <div class="multirow-form-container">
          <select id="sexo" name="sexo">
            <option value="">Seleccione una opcion</option>
            <option value="Masculino" <%= datos.sexo === "Masculino" ? "selected" : "" %>>Masculino</option>
            <option value="Femenino" <%= datos.sexo === "Femenino" ? "selected" : "" %>>Femenino</option>
          </select>
        </div>        
      </div>
    </div>
    <hr>
    <label for="contactoEmergencia">Datos de Contacto de Emergencia</label>
    <div class="multirow-container">
      <div class="element-container">
        <label for="nombreContacto">Nombre del Contacto:</label>
        <br>
        <div class="multirow-form-container">
          <input type="text" id="nombreContacto" name="nombreContacto" maxlength="100" value="<%= datos.nombreContacto || '' %>"><br> 
        </div>
      </div>
      <div class="element-container">
        <label for="apellidoPContacto">Apellido Paterno:</label>
        <br>
        <div class="multirow-form-container">
          <input type="text" id="apellidoPContacto" name="apellidoPContacto" maxlength="60" value="<%= datos.apellidoPContacto || '' %>"><br>
        </div>
      </div>
      <div class="element-container">
        <label for="apellidoMContacto">Apellido Materno:</label>
        <br>
        <div class="multirow-form-container">
          <input type="text" id="apellidoMContacto" name="apellidoMContacto" maxlength="60" value="<%= datos.apellidoMContacto || '' %>"><br>
        </div>
      </div>
    </div>
    <div class="multirow-container">
      <div class="element-container">
        <label for="parentescoContacto">Parentesco:</label>
        <br>
        <div class="multirow-form-container">
          <select id="parentescoContacto" name="parentescoContacto">
            <option value="">Seleccione el parentesco</option>
            <option value="Padre" <%= datos.parentescoContacto === "Padre" ? "selected" : "" %>>Padre</option>
            <option value="Madre" <%= datos.parentescoContacto === "Madre" ? "selected" : "" %>>Madre</option>
            <option value="Hermano/a" <%= datos.parentescoContacto === "Hermano/a" ? "selected" : "" %>>Hermano/a</option>
            <option value="Tío/a" <%= datos.parentescoContacto === "Tío/a" ? "selected" : "" %>>Tío/a</option>
            <option value="Abuelo/a" <%= datos.parentescoContacto === "Abuelo/a" ? "selected" : "" %>>Abuelo/a</option>
            <option value="Otro" <%= datos.parentescoContacto === "Otro" ? "selected" : "" %>>Otro</option>
          </select>
        </div>
      </div>
      <div class="element-container"></div>
      <div class="element-container"></div>
    </div>
    <hr>
    <label for="direccion">Direccion de vivienda</label>
    <div class="multirow-container">
      <div class="element-container">
        <label for="direccion">Estado:</label>
        <br>
        <div class="multirow-form-container">
          <select id="estado" name="estado" style="max-height: 100px; overflow-y: auto;">
            <option value="">Seleccione un estado</option>
            <option value="Aguascalientes" <%= datos.estado === "Aguascalientes" ? "selected" : "" %>>Aguascalientes</option>
            <option value="Baja California" <%= datos.estado === "Baja California" ? "selected" : "" %>>Baja California</option>
            <option value="Baja California Sur" <%= datos.estado === "Baja California Sur" ? "selected" : "" %>>Baja California Sur</option>
            <option value="Campeche" <%= datos.estado === "Campeche" ? "selected" : "" %>>Campeche</option>
            <option value="Chiapas" <%= datos.estado === "Chiapas" ? "selected" : "" %>>Chiapas</option>
            <option value="Chihuahua" <%= datos.estado === "Chihuahua" ? "selected" : "" %>>Chihuahua</option>
            <option value="Ciudad de México" <%= datos.estado === "Ciudad de México" ? "selected" : "" %>>Ciudad de México</option>
            <option value="Coahuila" <%= datos.estado === "Coahuila" ? "selected" : "" %>>Coahuila</option>
            <option value="Colima" <%= datos.estado === "Colima" ? "selected" : "" %>>Colima</option>
            <option value="Durango" <%= datos.estado === "Durango" ? "selected" : "" %>>Durango</option>
            <option value="Estado de México" <%= datos.estado === "Estado de México" ? "selected" : "" %>>Estado de México</option>
            <option value="Guanajuato" <%= datos.estado === "Guanajuato" ? "selected" : "" %>>Guanajuato</option>
            <option value="Guerrero" <%= datos.estado === "Guerrero" ? "selected" : "" %>>Guerrero</option>
            <option value="Hidalgo" <%= datos.estado === "Hidalgo" ? "selected" : "" %>>Hidalgo</option>
            <option value="Jalisco" <%= datos.estado === "Jalisco" ? "selected" : "" %>>Jalisco</option>
            <option value="Michoacán" <%= datos.estado === "Michoacán" ? "selected" : "" %>>Michoacán</option>
            <option value="Morelos" <%= datos.estado === "Morelos" ? "selected" : "" %>>Morelos</option>
            <option value="Nayarit" <%= datos.estado === "Nayarit" ? "selected" : "" %>>Nayarit</option>
            <option value="Nuevo León" <%= datos.estado === "Nuevo León" ? "selected" : "" %>>Nuevo León</option>
            <option value="Oaxaca" <%= datos.estado === "Oaxaca" ? "selected" : "" %>>Oaxaca</option>
            <option value="Puebla" <%= datos.estado === "Puebla" ? "selected" : "" %>>Puebla</option>
            <option value="Querétaro" <%= datos.estado === "Querétaro" ? "selected" : "" %>>Querétaro</option>
            <option value="Quintana Roo" <%= datos.estado === "Quintana Roo" ? "selected" : "" %>>Quintana Roo</option>
            <option value="San Luis Potosí" <%= datos.estado === "San Luis Potosí" ? "selected" : "" %>>San Luis Potosí</option>
            <option value="Sinaloa" <%= datos.estado === "Sinaloa" ? "selected" : "" %>>Sinaloa</option>
            <option value="Sonora" <%= datos.estado === "Sonora" ? "selected" : "" %>>Sonora</option>
            <option value="Tabasco" <%= datos.estado === "Tabasco" ? "selected" : "" %>>Tabasco</option>
            <option value="Tamaulipas" <%= datos.estado === "Tamaulipas" ? "selected" : "" %>>Tamaulipas</option>
            <option value="Tlaxcala" <%= datos.estado === "Tlaxcala" ? "selected" : "" %>>Tlaxcala</option>
            <option value="Veracruz" <%= datos.estado === "Veracruz" ? "selected" : "" %>>Veracruz</option>
            <option value="Yucatán" <%= datos.estado === "Yucatán" ? "selected" : "" %>>Yucatán</option>
            <option value="Zacatecas" <%= datos.estado === "Zacatecas" ? "selected" : "" %>>Zacatecas</option>
          </select>
        </div>
      </div>
      <div class="element-container">
        <label for="direccion">Ciudad:</label>
        <br>
        <div class="multirow-form-container">
          <input type="text" id="ciudad" name="ciudad" maxlength="100" value="<%= datos.ciudad || '' %>"><br>
        </div>
      </div>
      <div class="element-container">
        <label for="direccion">Calle:</label>
        <br>
        <div class="multirow-form-container">
          <input type="text" id="calle" name="calle" maxlength="100" value="<%= datos.calle || '' %>"><br>
        </div>
      </div>
      <div class="element-container">
        <label for="direccion">Codigo Postal:</label>
        <br>
        <div class="multirow-form-container">
          <input type="text" id="cp" name="cp" maxlength="5" value="<%= datos.cp || '' %>"><br>
        </div>
      </div>
      <div class="element-container">
        <label for="direccion">Localidad:</label>
        <br>
        <div class="multirow-form-container">
          <input type="text" id="localidad" name="localidad" maxlength="100" value="<%= datos.localidad || '' %>"><br>
        </div>
      </div>
      <div class="element-container">
        <label for="direccion">Numero de casa:</label>
        <br>
        <div class="multirow-form-container">
          <input type="input" id="numCasa" name="numCasa" maxlength="10" value="<%= datos.numCasa || '' %>"><br>
        </div>
      </div>
    </div>
    <hr>
    <label for="direccion">Datos medicos</label>
    <div class="multirow-container">
      <div class="element-container">
        <label for="enfermedades">Enfermedades:</label><br>
        <div class="multirow-form-container">
          <input type="text" id="enfermedades" name="enfermedades" maxlength="255" value="<%= datos.enfermedades || '' %>"><br>
        </div>
      </div>
      <div class="element-container">
        <label for="medicamentos">Medicamentos:</label><br>
        <div class="multirow-form-container">
          <input type="text" id="medicamentos" name="medicamentos" maxlength="255" value="<%= datos.medicamentos || '' %>"><br>
        </div>
      </div>
    </div>
    <div class="multirow-container">
      <div class="element-container">
        <label for="estudioSocioeconomico">Estudio Socioeconómico:</label>
        <br>
        <div class="multirow-form-container">
          <select id="estudioSocioeconomico" name="estudioSocioeconomico">
            <option value="">Seleccione una opcion</option>
            <option value="Si" <%= datos.estudioSocioeconomico === "Si" ? "selected" : "" %> >Si</option>
            <option value="No" <%= datos.estudioSocioeconomico === "No" ? "selected" : "" %> >No</option>
          </select>
          <br>
        </div>
      </div>
      <div class="element-container">
        <label for="curso">Tipo de sangre:</label>
        <br>
        <div class="multirow-form-container">
          <select id="sangre" name="sangre">
            <option value="">Seleccione el tipo de sangre</option>
            <option value="A+" <%= datos.sangre === "A+" ? "selected" : "" %>>A+</option>
            <option value="A-" <%= datos.sangre === "A-" ? "selected" : "" %>>A-</option>
            <option value="B+" <%= datos.sangre === "B+" ? "selected" : "" %>>B+</option>
            <option value="B-" <%= datos.sangre === "B-" ? "selected" : "" %>>B-</option>
            <option value="AB+" <%= datos.sangre === "AB+" ? "selected" : "" %>>AB+</option>
            <option value="AB-" <%= datos.sangre === "AB-" ? "selected" : "" %>>AB-</option>
            <option value="O+" <%= datos.sangre === "O+" ? "selected" : "" %>>O+</option>
            <option value="O-" <%= datos.sangre === "O-" ? "selected" : "" %>>O-</option>
            
          </select>
        </div>
      </div>
    </div>
    <hr>
    <label for="direccion">Datos academicos</label>
    <div class="multirow-container">
      <div class="element-container">
        <label for="grado">Grado:</label>
        <br>
        <div class="multirow-form-container">
          <select id="grado" name="grado">
            <option value="">Seleccione un grado</option>
            <option value="1°" <%= datos.grado === "1°" ? "selected" : "" %>>1°</option>
            <option value="2°" <%= datos.grado === "2°" ? "selected" : "" %>>2°</option>
            <option value="3°" <%= datos.grado === "3°" ? "selected" : "" %>>3°</option>
            <option value="4°" <%= datos.grado === "4°" ? "selected" : "" %>>4°</option>
            <option value="5°" <%= datos.grado === "5°" ? "selected" : "" %>>5°</option>
            <option value="6°" <%= datos.grado === "6°" ? "selected" : "" %>>6°</option>
          </select>
          <br>
        </div>
      </div>
      <div class="element-container">
        <label for="nvEscolar">Nivel escolar:</label>
        <br>
        <div class="multirow-form-container">
          <select id="nvEscolar" name="nvEscolar">
            <option value="">Seleccione nivel escolar</option>
            <option value="Preescolar" <%= datos.nvEscolar === "Preescolar" ? "selected" : "" %>>Preescolar</option>
            <option value="Primaria" <%= datos.nvEscolar === "Primaria" ? "selected" : "" %>>Primaria</option>
            <option value="Secundaria" <%= datos.nvEscolar === "Secundaria" ? "selected" : "" %>>Secundaria</option>
            <option value="Preparatoria" <%= datos.nvEscolar === "Preparatoria" ? "selected" : "" %>>Preparatoria</option>
          </select>
          <br>
        </div>
      </div>
    </div>
    <div class="multirow-container">
    <div class="element-container"></div>
    <div class="element-container"></div>
    <div class="element-container">
      <button class="button is-save" id="btn-guardar">Guardar</button>
      <button class="button is-cancel" id="btn-cancelar">Cancelar</button>
    </div>
    <div class="element-container"></div>
    <div class="element-container"></div>
    </div>
  </div>
  </div>
</section>

<script src="/js/editarPaciente.js"></script>
</body>
