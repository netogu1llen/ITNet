<%- include('partials/head') %>
<body>
  <!-- Cuerpo del modal -->
  <section class="modal-card-body" style="text-align: center;">
    <!-- Ícono e título centrados -->
    <div style="margin-bottom: 20px;">
      <img src="/images/modificarusuario.png" alt="Icono de usuario" style="width: 100px; height: 100px;">
    </div>
    <h1 class="title" style="margin-bottom: 30px;">Editar Paciente</h1>
    <div class="white-container">
    <div class="full-white-container">
    <div class="multirow-container">
      <div class="element-container"></div>
      <div class="element-container"></div>
      <div class="element-container">
        <label for="numExpediente">Numero de expediente</label><br>
        <div class="multirow-form-container">
          <input type="text" id="numExpediente" name="numExpediente" maxlength="15" value="<%= datos.numExpediente || '' %>"><br>
        </div>
      </div>
      <div class="element-container"></div>
      <div class="element-container"></div>
    </div>
    <hr>
    <label for="direccion">Datos personales</label>
    <div class="multirow-container">
      <div class="element-container">
        <label for="nombres">Nombres:</label><br>
        <div class="multirow-form-container">
          <input type="text" id="nombres" name="nombres" maxlength="50" value="<%= datos.nombres || '' %>"><br>
        </div>
      </div>

      <div class="element-container">
        <label for="apellidoP">Apellido Paterno:</label><br>
        <div class="multirow-form-container">
          <input type="text" id="apellidoP" name="apellidoP" maxlength="30" value="<%= datos.apellidoP || '' %>"><br>
        </div>
      </div>
      <div class="element-container">
        <label for="apellidoM">Apellido Materno:</label><br>
        <div class="multirow-form-container">
          <input type="text" id="apellidoM" name="apellidoM" maxlength="30" value="<%= datos.apellidoM || '' %>"><br>
        </div>
      </div>
    </div>
    <div class="multirow-container">
      <div class="element-container">
        <label for="fechaNacimiento">Fecha de Nacimiento:</label><br>
        <div class="multirow-form-container">
          <input type="date" id="fechaNacimiento" name="fechaNacimiento"
                 value="<%= datos.fechaNacimiento || '' %>"  max=""><br>
        </div>
      </div>

      <div class="element-container">
        <label for="contacto">Contacto(numero de telefono):</label><br>
        <div class="multirow-form-container">
          <input type="tel" id="contacto" name="contacto" maxlength="10" pattern="[0-9]{10}" title="Ingrese un número de teléfono válido de 10 dígitos" value="<%= datos.contacto || '' %>"><br>
        </div>
      </div>
    </div>
    <hr>
    <label for="direccion">Direccion de vivienda</label>
    <div class="multirow-container">
      <div class="element-container">
        <label for="direccion">Estado:</label>
        <br>
        <div class="multirow-form-container">
          <input type="text" id="estado" name="estado" maxlength="100" value="<%= datos.estado || '' %>"><br>
        </div>
      </div>
      <div class="element-container">
        <label for="direccion">Ciudad:</label>
        <br>
        <div class="multirow-form-container">
          <input type="text" id="ciudad" name="ciudad" maxlength="100" value="<%= datos.ciudad || '' %>"><br>
        </div>
      </div>
      <div class="element-container">
        <label for="direccion">Calle:</label>
        <br>
        <div class="multirow-form-container">
          <input type="text" id="calle" name="calle" maxlength="100" value="<%= datos.calle || '' %>"><br>
        </div>
      </div>
      <div class="element-container">
        <label for="direccion">Codigo Postal:</label>
        <br>
        <div class="multirow-form-container">
          <input type="text" id="cp" name="cp" maxlength="5" value="<%= datos.cp || '' %>"><br>
        </div>
      </div>
      <div class="element-container">
        <label for="direccion">Localidad:</label>
        <br>
        <div class="multirow-form-container">
          <input type="text" id="localidad" name="localidad" maxlength="100" value="<%= datos.localidad || '' %>"><br>
        </div>
      </div>
      <div class="element-container">
        <label for="direccion">Numero de casa:</label>
        <br>
        <div class="multirow-form-container">
          <input type="input" id="numCasa" name="numCasa" maxlength="10" value="<%= datos.numCasa || '' %>"><br>
        </div>
      </div>
    </div>
    <hr>
    <label for="direccion">Datos medicos</label>
    <div class="multirow-container">
      <div class="element-container">
        <label for="enfermedades">Enfermedades:</label><br>
        <div class="multirow-form-container">
          <input type="text" id="enfermedades" name="enfermedades" maxlength="255" value="<%= datos.enfermedades || '' %>"><br>
        </div>
      </div>
      <div class="element-container">
        <label for="medicamentos">Medicamentos:</label><br>
        <div class="multirow-form-container">
          <input type="text" id="medicamentos" name="medicamentos" maxlength="255" value="<%= datos.medicamentos || '' %>"><br>
        </div>
      </div>
    </div>
    <div class="multirow-container">
      <div class="element-container">
        <label for="estudioSocioeconomico">Estudio Socioeconómico:</label>
        <br>
        <div class="multirow-form-container">
          <select id="estudioSocioeconomico" name="estudioSocioeconomico">
            <option value="">Seleccione una opcion</option>
            <option value="Si" <%= datos.estudioSocioeconomico === "Si" ? "selected" : "" %> >Si</option>
            <option value="No" <%= datos.estudioSocioeconomico === "No" ? "selected" : "" %> >No</option>
          </select>
          <br>
        </div>
      </div>
      <div class="element-container">
        <label for="curso">Tipo de sangre:</label>
        <br>
        <div class="multirow-form-container">
          <select id="sangre" name="sangre">
            <option value="">Seleccione el tipo de sangre</option>
            <option value="A+" <%= datos.sangre === "A+" ? "selected" : "" %>>A+</option>
            <option value="A-" <%= datos.sangre === "A-" ? "selected" : "" %>>A-</option>
            <option value="B+" <%= datos.sangre === "B+" ? "selected" : "" %>>B+</option>
            <option value="B-" <%= datos.sangre === "B-" ? "selected" : "" %>>B-</option>
            <option value="AB+" <%= datos.sangre === "AB+" ? "selected" : "" %>>AB+</option>
            <option value="AB-" <%= datos.sangre === "AB-" ? "selected" : "" %>>AB-</option>
            <option value="O+" <%= datos.sangre === "O+" ? "selected" : "" %>>O+</option>
            <option value="O-" <%= datos.sangre === "O-" ? "selected" : "" %>>O-</option>
            
          </select>
        </div>
      </div>
    </div>
    <hr>
    <label for="direccion">Datos academicos</label>
    <div class="multirow-container">
      <div class="element-container">
        <label for="grado">Grado:</label>
        <br>
        <div class="multirow-form-container">
          <select id="grado" name="grado">
            <option value="">Seleccione un grado</option>
            <option value="1°" <%= datos.grado === "1°" ? "selected" : "" %>>1°</option>
            <option value="2°" <%= datos.grado === "2°" ? "selected" : "" %>>2°</option>
            <option value="3°" <%= datos.grado === "3°" ? "selected" : "" %>>3°</option>
            <option value="4°" <%= datos.grado === "4°" ? "selected" : "" %>>4°</option>
            <option value="5°" <%= datos.grado === "5°" ? "selected" : "" %>>5°</option>
            <option value="6°" <%= datos.grado === "6°" ? "selected" : "" %>>6°</option>
          </select>
          <br>
        </div>
      </div>
      <div class="element-container">
        <label for="nvEscolar">Nivel escolar:</label>
        <br>
        <div class="multirow-form-container">
          <select id="nvEscolar" name="nvEscolar">
            <option value="">Seleccione nivel escolar</option>
            <option value="Preescolar" <%= datos.nvEscolar === "Preescolar" ? "selected" : "" %>>Preescolar</option>
            <option value="Primaria" <%= datos.nvEscolar === "Primaria" ? "selected" : "" %>>Primaria</option>
            <option value="Secundaria" <%= datos.nvEscolar === "Secundaria" ? "selected" : "" %>>Secundaria</option>
          </select>
          <br>
        </div>
      </div>
    </div>
    <div class="multirow-container">
    <div class="element-container"></div>
    <div class="element-container"></div>
    <div class="element-container">
      <button class="button is-save" id="btn-guardar">Guardar</button>
      <button class="button is-cancel" id="btn-cancelar">Cancelar</button>
    </div>
    <div class="element-container"></div>
    <div class="element-container"></div>
    </div>
  </div>
  </div>
</section>

<script src="/js/editarPaciente.js"></script>
</body>
