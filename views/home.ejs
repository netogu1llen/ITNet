                    <div class="field-letters"> > Edad paciente</div>
                    <br>
                    <div class="title-letters"> 10 años</div>
                </div>
                
            </div>
            </div>
            <div class="white-container">
            <div class="title-letters">Evolución Antropométrica - Comparativa Mensual</div>
            <canvas id="grafico" 
                data-labels='<%= JSON.stringify(datos.labels) %>' 
