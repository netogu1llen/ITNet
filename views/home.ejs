<%- include('partials/head') %>
    <style>
        body {
            background-color: #FFFFFF; /* Fondo blanco */
            margin: 0;
            padding: 0;
            font-family: 'Encode Sans', sans-serif;
        }
        .gray-container {
          width: calc(100% - 160px); /* Ocupa toda la página menos los márgenes izquierdo (90px) y derecho (20px) */
          margin: 20px 20px 20px 90px; /* Margen de 20px arriba, 20px derecha e inferior, 90px izquierda */
          padding: 20px;
          text-align: left;
          background-color: #F2F2F2; /* Fondo gris claro */
          border-radius: 7px;
          box-shadow: 0 2px 5px rgba(0,0,0,0.1);
          display: flex;
          flex-wrap: wrap; /* Permite que los contenedores se ajusten de manera flexible */
          justify-content: space-between; /* Alinea los contenedores a la izquierda y derecha */
        }
        .head-container {
            width: 100%; /* Ocupa todo el ancho */
            display: flex;
            justify-content: space-between; /* Alinea título y botones */
            margin-bottom: 20px; /* Añade un margen inferior para separar de los otros contenedores */
        }
        .head-title {
            display: flex;
            align-items: center; /* Alinea el icono y el título verticalmente */
            font-size: 32px;
            font-weight: Medium;
            color: #000;
        }
        .title-letters{
            display: flex;
            align-items: center; /* Alinea el icono y el título verticalmente */
            font-size: 14px;
            font-weight: Bold;
            color: #000;
        }
        .field-letters{
            display: flex;
            align-items: center; /* Alinea el icono y el título verticalmente */
            font-size: 14px;
            font-weight: Bold;
            color: #595959;
        }
        .field-letters2{
            display: flex;
            text-align: right;
            font-size: 14px;
            font-weight: Bold;
            color: #595959;
        }
        .data-letters {
            display: flex;
            align-items: center; /* Alinea el icono y el título verticalmente */
            font-size: 14px;
            font-weight: Bold;
            color: #000;
        }
        .head-title img {
            width: 30px; /* Ajusta el tamaño del icono */
            height: 30px;
            margin-right: 10px; /* Espacio entre el icono y el texto */
        }
        .buttons-container {
            display: flex;
            gap: 10px; /* Espacio entre los botones */
            justify-content: flex-end; /* Alinea los botones a la derecha */
        }
        .white-container {
            width: 48%; /* Ocupa el 50% del ancho disponible menos márgenes */
            margin: 10px 0; /* Margen de 10px en la parte superior e inferior */
            padding: 20px;
            text-align: center;
            justify-content: space-between;
            background-color: #FFFFFF; /* Fondo blanco */
            border-radius: 7px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            border: 1px solid #ddd; /* Un pequeño borde para diferenciarlo */
        }
        .white-container2 {
            width: 98%; /* Ocupa el 50% del ancho disponible menos márgenes */
            margin: 10px 0; /* Margen de 10px en la parte superior e inferior */
            padding: 20px;
            text-align: center;
            background-color: #FFFFFF; /* Fondo blanco */
            border-radius: 7px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            border: 1px solid #ddd; /* Un pequeño borde para diferenciarlo */
        }
        .white-container3 {
          flex: 1;
          min-width: 120px;
          padding: 10px;
          text-align: left;
          background-color: #FFFFFF;
          border-radius: 7px;
          /*box-shadow: 0 2px 5px rgba(0,0,0,0.1); /* Le quitamos el sombreado por el momento*/
          /*border: 1px solid #ddd; /* Le quitamos el borde por el momento*/
        }
        .white-container-row {
            display: flex;
            justify-content: space-between; /* Distribuye los elementos uniformemente */
            gap: 10px; /* Espaciado entre los elementos */
        }
        .search-button {
          background-color: #ffffff; /* Fondo blanco */
          border: 2px solid #ccc; /* Borde gris claro */
          padding: 10px 20px; /* Asegura que el botón tenga un tamaño adecuado */
          font-size: 14px; /* Tamaño de fuente adecuado */
          font-weight: bold;
          color: #333;
          border-radius: 20px; /* Bordes redondeados */
          display: flex;
          align-items: center; /* Centra el contenido verticalmente */
          justify-content: center; /* Centra el contenido horizontalmente */
          gap: 8px; /* Espacio entre el texto y el icono */
          cursor: pointer;
          transition: background-color 0.3s, border-color 0.3s; /* Transiciones suaves */
        }
        .search-button:hover {
            background-color: #f1f1f1; /* Cambio de fondo al pasar el mouse */
            border-color: #888; /* Cambio de color del borde al pasar el mouse */
        }
        .material-icons {
            font-size: 20px; /* Tamaño del icono */
        }
        /* Contenedor A flexible */
        .container-a {
            display: flex;
            width: 100%; /* Ocupa todo el ancho */
            gap: 20px; /* Espacio entre los contenedores A */
        }
        .month-filter-container {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
        }
        .month-filter-container select,
        .month-filter-container button {
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        .month-filter-container button {
            background-color: #f0f0f0;
            cursor: pointer;
            transition: background-color 0.3s;
        }
        .month-filter-container button:hover {
            background-color: #e0e0e0;
        }
    </style>
<body>
    <div class="gray-container">
        <div class="head-container">
            <div class="head-title">
                <img src="/images/icono_salud.png" alt="Icono Salud"> <!-- Icono cargado desde la carpeta public -->
                Oscar Javier Villeda Arteaga
            </div>
            <!-- Contenedor para los botones alineados a la derecha -->
            <div class="buttons-container">
