                </div>
                <div class="white-container-row">
                    <div class="title-letters">Lipidos</div>
                    <div class="field-letters2">70 g/día (30% de las kcal)</div>
                </div>
                <div class="white-container-row">
                    <div class="title-letters">Proteinas</div>
                    <div class="field-letters2">100 g/día (20% de las kcal)</div>
                </div>
                <div class="white-container-row">
                    <div class="title-letters">Fibra</div>
                    <div class="field-letters2">30 g/día</div>
                </div>
                <div class="white-container-row">
                    <div class="title-letters">Agua</div>
                    <div class="field-letters2">2500 ml/día</div>
                </div>
            </div>
        </div>
        </div>
        <div class="container-a">
          <div class="white-container2">
            <div class="title-letters">Sesiones</div>
          </div>
      </div>
    </div>
    
    <script src="/js/chartConfig.js" type="module" defer></script>
</body>
</html>
