                height="300">
            </canvas>
            <div class="month-filter-container">
                <select id="mes-inicio">
                    <option value="Enero">Enero</option>
                    <option value="Febrero">Febrero</option>
                    <option value="Marzo">Marzo</option>
                    <option value="Abril">Abril</option>
                    <option value="Mayo">Mayo</option>
                    <option value="Junio">Junio</option>
                    <option value="Julio">Julio</option>
                    <option value="Agosto">Agosto</option>
                    <option value="Septiembre">Septiembre</option>
                    <option value="Octubre">Octubre</option>
                    <option value="Noviembre">Noviembre</option>
                    <option value="Diciembre">Diciembre</option>
                </select>
            
                <select id="mes-final">
                    <option value="Enero">Enero</option>
                    <option value="Febrero">Febrero</option>
                    <option value="Marzo">Marzo</option>
                    <option value="Abril">Abril</option>
                    <option value="Mayo">Mayo</option>
                    <option value="Junio">Junio</option>
                    <option value="Julio">Julio</option>
                    <option value="Agosto">Agosto</option>
                    <option value="Septiembre">Septiembre</option>
                    <option value="Octubre">Octubre</option>
                    <option value="Noviembre">Noviembre</option>
                    <option value="Diciembre">Diciembre</option>
                </select>
            
                <button id="filtrar-meses">Filtrar</button>
            </div>
        </div>
    </div>

        <!-- Otro contenedor A con dos contenedores blancos alineados -->
        <div class="container-a">
            <div class="white-container">
              <div class="title-letters">Antecedentes del paciente</div>
              <br>
              <div class="white-container-row">
                <div class="white-container3">
                    <div class="field-letters"> > Antecedentes heredofamiliares</div>
                    <br>
                    <div class="white-container-row">
                        <div class="title-letters">Diabetes</div>
                        <div class="field-letters2">Madre</div>
                    </div>
                    <div class="white-container-row">
                        <div class="title-letters">Cancer</div>
                        <div class="field-letters2">Ninguno</div>
                    </div>
                    <div class="white-container-row">
                        <div class="title-letters">Dislipidemia</div>
                        <div class="field-letters2">Abuelo paterno</div>
                    </div>
                    <div class="white-container-row">
                        <div class="title-letters">Obesidad</div>
                        <div class="field-letters2">Hermano</div>
                    </div>
                    <div class="white-container-row">
                        <div class="title-letters">Anemia</div>
                        <div class="field-letters2">Ninguno</div>
                    </div>
                    <div class="white-container-row">
                        <div class="title-letters">Hipertension arterial</div>
                        <div class="field-letters2">Padre y abuelo materno asdfasdfasdfasd</div>
                    </div>
                </div>
                <div class="white-container3">
                    <div class="field-letters"> > Antecedentes personales</div>
                    <br>
                    <div class="white-container-row">
                        <div class="title-letters">Peso al nacer</div>
                        <div class="field-letters2">3.2kg</div>
                    </div>
                    <div class="white-container-row">
                        <div class="title-letters">Talla al nacer</div>
                        <div class="field-letters2">50cm</div>
                    </div>
                    <div class="white-container-row">
                        <div class="title-letters">SDG</div>
                        <div class="field-letters2">Abuelo paterno</div>
                    </div>
                    <div class="white-container-row">
                        <div class="title-letters">Tipo de parto</div>
                        <div class="field-letters2">Vaginal</div>
                    </div>
                </div>
            </div>
            <div class="white-container3">
                <div class="field-letters"> > Antecedentes de alimentacion</div>
                <br>
                <div class="white-container-row">
                    <div class="title-letters">Lactancia exclusiva</div>
                    <div class="field-letters">Mixta</div>
                </div>
                <div class="white-container-row">
                    <div class="title-letters">Tiempo</div>
                    <div class="field-letters">-6 meses</div>
                </div>
                <div class="white-container-row">
                    <div class="title-letters">Edad de alimentacion complementaria  </div>
                    <div class="field-letters">-6 meses</div>
                </div>
            </div>
        </div>
        <div class="white-container">
            <div class="title-letters">Manejo Nutricional</div>
            <br>
            <div class="white-container3">
                <br>
