          <th>Parámetro Bioquímico</th>
          <th>Valor de referencia</th>
          <th>Fecha</th>
        </tr>
      </thead>
      <tbody>
        <% if (datosSesion?.indicadoresBioquim && datosSesion.indicadoresBioquim.length > 0) { %>
          <% datosSesion.indicadoresBioquim.forEach(function(indicador) { %>
            <tr>
              <td><%= indicador.parametro %></td>
              <td><%= indicador.valorReferencia %></td>
              <td><%= formatDate(indicador.parametroFecha) %></td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="3" style="text-align: center;">No hay indicadores registrados</td>
          </tr>
        <% } %>
      </tbody>
    </table>
    
