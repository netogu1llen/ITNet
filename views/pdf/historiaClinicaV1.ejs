              <td><%= datosSesion?.nutricional1?.tiempo || '' %></td>
            </tr>
            <tr>
              <td>Edad de alimentación complementaria</td>
              <td><%= datosSesion?.nutricional1?.edadAlimentacionComplementaria || '' %></td>
            </tr>
            <tr>
              <td>Alimentos introducidos el 1er año</td>
