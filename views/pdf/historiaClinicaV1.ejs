              <p><strong>Fecha de nacimiento:</strong> <%= expediente.fechaNacimiento %></p>
            </div>
            <div class="column">
              <p><strong>Edad (años):</strong> <%= calcularEdad(expediente.fechaNacimiento) %></p>
