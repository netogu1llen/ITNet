            <tr>
              <th colspan="2" class="section-title">III. ANTECEDENTES DE ALIMENTACIÓN</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td width="40%">Tipo de lactancia</td>
              <td>
                <% 
                  let tipoLactancia = '';
                  if (datosSesion?.nutricional1?.lactancia === 'value1') tipoLactancia = 'Lactancia exclusiva';
                  if (datosSesion?.nutricional1?.lactancia === 'value2') tipoLactancia = 'Fórmula';
                  if (datosSesion?.nutricional1?.lactancia === 'value3') tipoLactancia = 'Mixta';
                %>
                <%= tipoLactancia %>
              </td>
            </tr>
            <tr>
