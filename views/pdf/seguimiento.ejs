
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Seguimiento Psicológico</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            margin: 40px;
        }
        h2 {
            text-align: center;
            margin-bottom: 30px;
        }
        .info, .section {
            margin-bottom: 20px;
        }
        .info-row {
            display: flex;
            justify-content: space-between;
        }
        .info-col {
            width: 32%;
        }
        .section-title {
            font-weight: bold;
            margin-bottom: 5px;
        }
        .textarea {
            border: 1px solid #000;
            min-height: 60px;
            padding: 5px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }
        table, th, td {
            border: 1px solid #000;
        }
        th, td {
            padding: 4px;
            text-align: left;
        }
    </style>
</head>
<body>

    <h2>1. SEGUIMIENTO PSICOLÓGICO</h2>

    <div class="info">
        <div class="info-row">
            <div class="info-col"><strong>Nombre:</strong> <%= expediente.nombres %> <%= expediente.apellidoP %> <%= expediente.apellidoM %></div>
            <div class="info-col"><strong>Fecha de nacimiento:</strong> <%= expediente.fechaNacimiento %></div>
            <div class="info-col"><strong>Edad cronológica:</strong> <%= expediente.edad || 'Sin dato' %></div>
        </div>
        <div class="info-row">
            <div class="info-col"><strong>Dirección:</strong> <%= expediente.direccion || 'Sin dato' %></div>
            <div class="info-col"><strong>Estatura:</strong> <%= expediente.estatura || 'Sin dato' %></div>
            <div class="info-col"><strong>Peso:</strong> <%= expediente.peso || 'Sin dato' %></div>
        </div>
        <div class="info-row">
            <div class="info-col"><strong>Grado que cursa:</strong> <%= expediente.grado || 'Sin dato' %></div>
        </div>
    </div>

    <div class="section">
        <div class="section-title">Objetivo de la sesión:</div>
        <div class="textarea"><%= seguimiento.sesionObjetivo %></div>
    </div>

    <div class="section">
        <div class="section-title">Justificación de la sesión:</div>
        <div class="textarea"><%= seguimiento.sesionJustificacion %></div>
    </div>

    <div class="section">
        <div class="section-title">Actividades:</div>
        <table>
            <thead>
                <tr>
                    <th>Actividad</th>
                    <th>Tiempo</th>
                    <th>Metodología</th>
                    <th>Objetivo</th>
                    <th>Observaciones</th>
                </tr>
            </thead>
            <tbody>
                <% actividades.forEach(a => { %>
                    <tr>
                        <td><%= a.actividad %></td>
                        <td><%= a.tiempo %></td>
                        <td><%= a.metodologia %></td>
                        <td><%= a.objetivo %></td>
                        <td><%= a.observaciones %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <div class="section">
        <div class="section-title">Análisis psicológico:</div>
        <div class="textarea"><%= seguimiento.analisisPsicologico %></div>
    </div>

    <div class="section">
        <div class="section-title">Recomendaciones:</div>
        <div class="textarea"><%= seguimiento.recomendaciones %></div>
    </div>

    <div class="section">
        <div class="section-title">Bitácora de sesión:</div>
        <div class="textarea"><%= seguimiento.sesionBitacora %></div>
    </div>

</body>
</html>
