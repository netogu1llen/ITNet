<%- include('partials/head') %>
<link rel="stylesheet" href="/styles.css">

<section class="section">
  <div class="container">
    <!-- Título principal -->
    <h1 class="title is-4">Educación</h1>

    <!-- Barra superior personalizada (JS injecta contenido) -->
    <div id="TopBar" class="dt-top-bar exp-psicologico-wide">
      <!-- Logo, búsqueda, número de registros y botón se inyectan desde JS -->
    </div>

    <!-- Tabla de alumnos -->
    <div class="exp-psicologico-wide" style="width: 100%; height: 900px;">
      <table
        id="alumnosTable"
        class="table is-striped is-hoverable is-fullwidth"
      >
      <thead>
        <tr>
          <th class="has-text-centered">Nombre</th>
          <th class="has-text-centered">Periodo Escolar</th>
          <th class="has-text-centered">Grado</th>
          <th class="has-text-centered">Nivel Escolar</th>
        </tr>
      </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>
</section>

<!-- JS -->
<script src="/vendor/jquery-3.6.0.min.js"></script>
<script src="/vendor/jquery.dataTables.min.js"></script>
<script src="/vendor/sweetalert2/sweetalert2.all.min.js"></script>
<script src="/js/sidebar.js"></script>
<script src="/js/educacion.js"></script>
